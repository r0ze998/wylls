+    pub fn read(o: &CandidateOptions) -> Result<CandidateAssets, String> {
+        let read = |p: &PathBuf, name: &str| -> Result<Vec<u8>, String> {
+            let b = std::fs::read(p).map_err(|e| format!("{name}: {e}"))?;
