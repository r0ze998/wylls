From 062868ac3c72c696359e2faa9f4312beeeed1f3c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 5 Nov 2026 12:59:21 +0000
Subject: [PATCH 3/3] web: name a sold resident and a stale resident session;
 texts for the gate's refusals

Shared-core diff 3 of 3 for NFT-bound residents (workstream 20); replaces
spike patch 04. matchesCitizen takes an optional resident (holder, gen,
session, sessionGen, sessionSetter): ResidentHolderChanged when another
wallet holds it, ResidentSessionStale when the key is not the current
holder's session of the current generation. Japanese and English texts
for these and the relay's ResidentSessionExpired and ResidentUnverified
(test/web-frontier-errors.test.mjs requires a text for every page code).
Without the fourth argument nothing changes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01C5Nj2aAnhS2uns3RrMveq4
---
 permutation-server/web/frontier/fi18n.mjs    | 4 ++++
 permutation-server/web/frontier/fsession.mjs | 8 +++++++-
 permutation-server/web/lang/en-frontier.mjs  | 4 ++++
 3 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/permutation-server/web/frontier/fi18n.mjs b/permutation-server/web/frontier/fi18n.mjs
index cdd18e74..4581a83c 100644
--- a/permutation-server/web/frontier/fi18n.mjs
+++ b/permutation-server/web/frontier/fi18n.mjs
@@ -274,6 +274,10 @@ const CLIENT_TEXT = {
   NoWallet: () => L`ウォレットが接続されていません`,
   NoSession: () => L`ゲーム内の鍵がありません。鍵を作ってください。`,
   SessionMismatch: () => L`このゲーム内の鍵は、登録されているものと違います`,
+  ResidentHolderChanged: () => L`この住民の NFT は、いまは別のウォレットが持っています。この鍵では操作できません。`,
+  ResidentSessionStale: () => L`この鍵は、住民の今の持ち主が今の世代で任せた鍵ではありません。持ち主が任せ直す必要があります。`,
+  ResidentSessionExpired: () => L`住民の操作を任せた鍵の期限が切れています。持ち主が任せ直す必要があります。`,
+  ResidentUnverified: () => L`住民の持ち主を確かめられなかったため、送りませんでした。あとでもう一度試してください。`,
   Expired: () => L`取引は期限までに記録されませんでした`,
   Unconfirmed: () => L`取引がまだ確認できません。あとで状態を確かめます。`,
   TransactionFailed: () => L`取引は記録されましたが失敗しました`,
diff --git a/permutation-server/web/frontier/fsession.mjs b/permutation-server/web/frontier/fsession.mjs
index 983181d5..19508346 100644
--- a/permutation-server/web/frontier/fsession.mjs
+++ b/permutation-server/web/frontier/fsession.mjs
@@ -108,7 +108,13 @@ export async function restore(scope, wallet) {
  * Whether a key is the one the Citizen registered (`Citizen.session`, 32
  * bytes, zero = none) and still valid at chain time `now` (s).
  */
-export function matchesCitizen(session, citizen, now) {
+export function matchesCitizen(session, citizen, now, resident = null) {
+  // NFT-bound residents (optional `resident`, as the gate reads it: holder, gen, session, sessionGen,
+  // sessionSetter): a key of a wallet that no longer holds the resident is `ResidentHolderChanged`, and a
+  // key the holder did not set in the current holder generation is `ResidentSessionStale`; neither is a
+  // key to regenerate silently.
+  if (resident?.holder && session?.wallet && resident.holder !== session.wallet) return { ok: false, code: 'ResidentHolderChanged', holder: resident.holder };
+  if (resident?.holder && (resident.session !== session?.publicKey || resident.sessionGen !== resident.gen || resident.sessionSetter !== resident.holder)) return { ok: false, code: 'ResidentSessionStale', gen: resident.gen };
   const reg = citizen?.session;
   if (!reg || reg.every?.(x => x === 0)) return { ok: false, code: 'NoSession' };
   if (toBase58(reg) !== session.publicKey) return { ok: false, code: 'SessionMismatch' };
