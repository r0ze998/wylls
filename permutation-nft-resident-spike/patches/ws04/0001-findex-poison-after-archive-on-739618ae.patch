+    /// The index writes of one pull, after its records are archived.
+    fn index_after_archive(&mut self, stored: &[TxRecord]) -> Result<(), String> {
+        self.index.mark_incomplete()?;
+        self.index.add(stored)?;
+        if self.index.last_seq()? != self.archive.last_seq() {
+            return Err("index did not catch up with archive".into());
+        }
+        self.index.mark_complete()
+    }
