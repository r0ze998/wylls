From 9709aefa86dd5d5ff833fdca0cf1680da53424db Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 30 Oct 2026 12:56:12 +0000
Subject: [PATCH 3/3] agent MCP: a server declares its source (mcp or ai)

An operator-run autopilot and a person's MCP client on one agent were both
recorded as source mcp with idempotency keys mcp:<id>. createAgentMcp takes
source ('mcp' default, or 'ai'); the key is <source>:<requestId>.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01C5Nj2a3vCeP8vokuv61Uw5
---
 permutation-gateway/mcp/agent-mcp.mjs         |  9 +++++---
 .../test/agent-wallet-mcp.test.mjs            | 22 +++++++++++++++++++
 2 files changed, 28 insertions(+), 3 deletions(-)

diff --git a/permutation-gateway/mcp/agent-mcp.mjs b/permutation-gateway/mcp/agent-mcp.mjs
index f7c606a6..8fd7cdf8 100644
--- a/permutation-gateway/mcp/agent-mcp.mjs
+++ b/permutation-gateway/mcp/agent-mcp.mjs
@@ -82,8 +82,11 @@ const fail = (code, message, extra = {}) => { const e = { ok: false, error: { co
  * @param {string} [o.herald]    the herald's base URL for world_read
  * @param {Function} [o.fetch]
  */
-export function createAgentMcp({ relay, agentId, capability, herald = null, fetch: f = globalThis.fetch, log = () => {} }) {
+export function createAgentMcp({ relay, agentId, capability, herald = null, fetch: f = globalThis.fetch, log = () => {}, source = 'mcp' }) {
   if (!relay || !agentId || !capability) throw new Error('relay, agentId and capability are required');
+  // Who acts through this server, as the relay records it: 'mcp' (a person's MCP client, the default) or 'ai' (an
+  // operator-run autopilot). Two clients on one agent stay apart in its history and their idempotency keys never meet.
+  if (source !== 'mcp' && source !== 'ai') throw new Error('source must be mcp or ai');
   const base = String(relay).replace(/\/+$/, '');
   const scrub = s => String(s ?? '').split(capability).join('[capability]');
 
@@ -118,9 +121,9 @@ export function createAgentMcp({ relay, agentId, capability, herald = null, fetc
     if (v.transport) return fail(v.error.code, v.error.message, { retrySameRequestId: true });
     if (v.status !== 200) return fail(v.json?.code ?? 'RelayError', scrub(v.json?.error ?? `HTTP ${v.status}`));
     const request = {
-      agentId, source: 'mcp',
+      agentId, source,
       // Deterministic: the same requestId is the same idempotency key across retries and restarts of this server.
-      idempotencyKey: `mcp:${args.requestId}`,
+      idempotencyKey: `${source}:${args.requestId}`,
       policyVersion: args.policyVersion, modeEpoch: args.modeEpoch,
       ...(typeof args.reason === 'string' ? { reason: args.reason.slice(0, 200) } : {}),
       action: { name: args.action.name, holding: v.json.village, fields: args.action.fields ?? {} },
diff --git a/permutation-gateway/test/agent-wallet-mcp.test.mjs b/permutation-gateway/test/agent-wallet-mcp.test.mjs
index b3036c80..edd0fe6d 100644
--- a/permutation-gateway/test/agent-wallet-mcp.test.mjs
+++ b/permutation-gateway/test/agent-wallet-mcp.test.mjs
@@ -190,3 +190,25 @@ test('MCP: the stdio transport is one JSON-RPC message per line', async () => {
   assert.equal(msgs.find(m => m.id === null).error.code, -32700);
   assert.equal(msgs.find(m => m.id === 8).result.tools.length, 4);
 });
+
+test('an MCP server can declare who acts through it: source ai keeps an autopilot apart from a person\'s MCP client on the same agent', async () => {
+  const { relay: mkRelay, createAgent: mk, call: callR, ownerCommand: oc, delegate: dg, policy: pol } = await import('./agent-wallet-fixtures.mjs');
+  const { Keypair: KP } = await import('@solana/web3.js');
+  const { createAgentMcp: create } = await import('../mcp/agent-mcp.mjs');
+  const r = mkRelay();
+  const owner = KP.generate();
+  const { agentId, agentKey, capability } = await mk(r, owner, { policy: pol(['economy']) });
+  await callR(r.public, 'POST', '/f/agent/command', { body: oc(owner, 'mode', { agentId, params: { mode: 'auto' } }), ip: '127.0.0.1' });
+  dg(r, owner.publicKey.toBase58(), agentKey);
+  const fetch = async (url, init = {}) => { const u = new URL(url); const res = await callR(r.public, init.method ?? 'GET', u.pathname + u.search, { body: init.body === undefined ? undefined : JSON.parse(init.body) }); return { status: res.status, json: async () => res.json }; };
+  assert.throws(() => create({ relay: 'http://relay.test', agentId, capability, fetch, source: 'browser' }), /source must be mcp or ai/);
+  const person = create({ relay: 'http://relay.test', agentId, capability, fetch });
+  const auto = create({ relay: 'http://relay.test', agentId, capability, fetch, source: 'ai' });
+  const v = r.gateway.view(agentId);
+  const args = id => ({ requestId: id, policyVersion: v.policy.version, modeEpoch: v.modeEpoch, action: { name: 'Harvest', fields: {} } });
+  const callTool = (m, name, a) => m.handle({ jsonrpc: '2.0', id: 1, method: 'tools/call', params: { name, arguments: a } });
+  await callTool(person, 'agent_act', args('same-id-0001'));
+  await callTool(auto, 'agent_act', args('same-id-0001'));
+  const acts = r.gateway.view(agentId).history.filter(h => h.type === 'action');
+  assert.deepEqual(acts.map(h => [h.source, h.key]).sort(), [['ai', 'ai:same-id-0001'], ['mcp', 'mcp:same-id-0001']]);
+});
