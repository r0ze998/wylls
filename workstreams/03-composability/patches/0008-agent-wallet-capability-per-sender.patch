diff --git a/permutation-gateway/test/agent-wallet-capability-per-source.test.mjs b/permutation-gateway/test/agent-wallet-capability-per-source.test.mjs
new file mode 100644
index 00000000..e45f5922
--- /dev/null
+++ b/permutation-gateway/test/agent-wallet-capability-per-source.test.mjs
@@ -0,0 +1,60 @@
+// Workstream 03 patch 0008 (④ AUTH-ROUTES A1): one capability per sender. KEY-FREE: no key is made, derived or used
+// and nothing is signed — the keyring is a fake that hands out a fixed public key string and refuses to sign, the
+// owner is a fixed address constant, owner commands are called on the gateway directly (the route's signature check
+// is the existing, unchanged code), and acceptance is read through whoami (read-only: no record, no hold, no send).
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { AgentGateway, CAPABILITY_SOURCES } from '../src/frontier/agent/gateway.mjs';
+import { AgentLedger } from '../src/frontier/agent/ledger.mjs';
+import { OWNER_OPS } from '../src/frontier/agent/owner-auth.mjs';
+
+const OWNER = '11111111111111111111111111111112'; // a fixed address constant (not a key anyone holds)
+const AGENT_KEY = 'Agent1111111111111111111111111111111111111';
+const keyring = { create: () => AGENT_KEY, isAgentKey: k => k === AGENT_KEY, sign: () => { throw new Error('this test signs nothing'); } };
+const ctx = { addresses: { citizen: () => 'Citizen111111111111111111111111111111111111' }, log: () => {} };
+const policy = { allowed: ['economy'], budget: { total: '1000000', perDay: '1000000' } };
+
+function gateway() {
+  const g = new AgentGateway({ ctx, ledger: new AgentLedger(), keyring, log: () => {} });
+  const made = g.createAgent({ owner: OWNER, village: [0, 0, 1], policy });
+  return { g, agentId: made.agent.agentId, legacy: made.capability.token };
+}
+const who = (g, agentId, capability) => { try { return g.whoami(agentId, { capability }); } catch (e) { return { error: e.code }; } };
+const req = (agentId, source) => ({ agentId, source, idempotencyKey: `${source}:k1`, policyVersion: 1, action: { name: 'Rest', holding: [0, 0, 1], fields: {} } });
+
+test('issuing one sender\'s capability leaves the other sender\'s and the unscoped token working', () => {
+  const { g, agentId, legacy } = gateway();
+  assert.deepEqual([...CAPABILITY_SOURCES], ['mcp', 'ai']);
+  assert.ok(OWNER_OPS.includes('issue-capability') && OWNER_OPS.includes('revoke-capability'));
+  const ai = g.issueSourceCapability(agentId, OWNER, 'ai').capability;
+  const mcp = g.issueSourceCapability(agentId, OWNER, 'mcp').capability;
+  assert.deepEqual([who(g, agentId, ai.token).source, who(g, agentId, mcp.token).source, who(g, agentId, legacy).source], ['ai', 'mcp', null]);
+  // ③ reconnects: a new mcp token replaces the old mcp token only.
+  const mcp2 = g.issueSourceCapability(agentId, OWNER, 'mcp').capability;
+  assert.equal(who(g, agentId, mcp.token).error, 'BadCapability');
+  assert.deepEqual([who(g, agentId, mcp2.token).source, mcp2.version, who(g, agentId, ai.token).source], ['mcp', 2, 'ai'], '⑤\'s ai token still works');
+  // The old global rotation replaces the unscoped token only.
+  g.rotateCapability(agentId, OWNER);
+  assert.equal(who(g, agentId, legacy).error, 'BadCapability');
+  assert.deepEqual([who(g, agentId, mcp2.token).source, who(g, agentId, ai.token).source], ['mcp', 'ai']);
+  // The public view lists the senders and versions, never a hash or token.
+  const v = g.view(agentId);
+  assert.deepEqual(v.capabilities, { ai: { version: 1 }, mcp: { version: 2 } });
+  assert.ok(!JSON.stringify(v).includes(mcp2.token) && !JSON.stringify(v).includes('hash'));
+});
+
+test('a sender\'s token acts as that sender only; revoking one sender leaves the other', async () => {
+  const { g, agentId } = gateway();
+  const ai = g.issueSourceCapability(agentId, OWNER, 'ai').capability;
+  const mcp = g.issueSourceCapability(agentId, OWNER, 'mcp').capability;
+  // Refused at authentication, before anything is built or signed.
+  await assert.rejects(g.submit(req(agentId, 'ai'), { capability: mcp.token }), e => e.code === 'BadCapability' && /issued for source mcp/.test(e.message));
+  await assert.rejects(g.submit(req(agentId, 'mcp'), { capability: ai.token }), e => e.code === 'BadCapability');
+  assert.equal(g.ledger.get(agentId).history.filter(h => h.type === 'action').length, 0, 'nothing recorded');
+  assert.equal(g.revokeSourceCapability(agentId, OWNER, 'mcp').revoked, true);
+  assert.equal(who(g, agentId, mcp.token).error, 'BadCapability');
+  assert.equal(who(g, agentId, ai.token).source, 'ai');
+  assert.equal(g.revokeSourceCapability(agentId, OWNER, 'mcp').revoked, false);
+  assert.throws(() => g.issueSourceCapability(agentId, OWNER, 'browser'), e => e.code === 'BadRequest');
+  assert.throws(() => g.issueSourceCapability(agentId, '11111111111111111111111111111113', 'mcp'), e => e.code === 'NotOwner');
+});
