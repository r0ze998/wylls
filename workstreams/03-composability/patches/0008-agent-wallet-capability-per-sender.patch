   /** The sha256 (hex) of the agent's current capability token; the token itself is never stored. */
+  /**
+   * A capability for one sender `source` (workstream 03 patch 0008, ④ AUTH-ROUTES A1): replaces that source's token
+   * only. The agent's other sources, and the unscoped token (setCapability), keep working.
+   */
+  setSourceCapability(agentId, source, hash) {
+    this.assertWritable();
+    const rec = this.get(agentId);
+    rec.capabilities ??= {};
+    const version = (rec.capabilities[source]?.version ?? 0) + 1;
+    rec.capabilities[source] = { hash, version, at: this.now() };
+    this.note(rec, { type: 'capability', source, version });
+    this.save();
+    return version;
+  }
+
+  /** Withdraws one source's capability; the others are untouched. False when it had none. */
+  revokeSourceCapability(agentId, source) {
+    this.assertWritable();
+    const rec = this.get(agentId);
+    if (!rec.capabilities?.[source]) return false;
+    const version = rec.capabilities[source].version;
+    delete rec.capabilities[source];
+    this.note(rec, { type: 'capability-revoked', source, version });
+    this.save();
+    return true;
+  }
