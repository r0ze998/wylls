+test('GET /f/tx/{signature}?detail=1 (workstream 03 patch 0007): commitment, fee, lifetime, and absence only when proven', async () => {
+  const r = relay();
+  const fp = await feePayerOf(r);
+  const res = await call(r.public, 'POST', '/f/relay', { body: { tx: playerTx({ name: 'Harvest', feePayer: fp }) }, ip: '203.0.113.9' });
+  const sig = res.json.signature;
+  const get = async () => (await call(r.public, 'GET', `/f/tx/${sig}?detail=1`, { ip: '203.0.113.9' })).json;
+  // Within its lifetime: unknown, not absent.
+  let j = await get();
+  assert.equal(j.state, 'unknown');
+  assert.deepEqual([j.detail.lastValidBlockHeight, j.detail.absence.proven, j.detail.absence.fate], [150, false, 'pending']);
+  // Past the confirmed height: the old answer says expired; absence is not proven (no transaction read).
+  r.chain.height = 151;
+  j = await get();
+  assert.equal(j.state, 'expired');
+  assert.deepEqual([j.detail.absence.proven, j.detail.absence.fate], [false, 'unknown']);
+  // Even with the transaction absent at finalized and full history from slot 0: the relay recorded no slot before the
+  // transaction was built, so coverage cannot be shown and absence stays unproven (recording it is the next step).
+  r.chain.getTransaction = async () => null;
+  r.chain.getFirstAvailableBlock = async () => 0;
+  j = await get();
+  assert.deepEqual([j.state, j.detail.absence.proven, j.detail.absence.fate], ['expired', false, 'unknown']);
+  assert.match(j.detail.absence.why, /no slot recorded/);
+  // Landed: the fee from the transaction's meta; never 0 when unknown.
+  r.chain.statuses.set(sig, { slot: 9, confirmationStatus: 'confirmed', err: null });
+  r.chain.getTransaction = async () => ({ meta: { fee: 5000, err: null } });
+  j = await get();
+  assert.deepEqual([j.state, j.slot, j.detail.commitment, j.detail.fee], ['landed', 9, 'confirmed', 5000]);
+  r.chain.getTransaction = async () => { throw new Error('rpc down'); };
+  assert.equal((await get()).detail.fee, null, 'not known is null, not 0');
+  // Failed: charged too.
+  r.chain.statuses.set(sig, { slot: 9, confirmationStatus: 'finalized', err: { InstructionError: [3, { Custom: 58 }] } });
+  r.chain.getTransaction = async () => ({ meta: { fee: 5000, err: {} } });
+  j = await get();
