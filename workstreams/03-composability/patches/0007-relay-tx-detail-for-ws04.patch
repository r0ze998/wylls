+/**
+ * What ④'s executor needs beside the state (patch 0007): the commitment the status was read at, the fee the chain
+ * charged (null when not known: never 0), the lifetime the relay recorded, and whether absence is *proven*. Reads that
+ * fail leave their field null; nothing here is guessed.
+ */
+async function txDetail(ctx, signature, st, known, state) {
+  const detail = { commitment: st?.confirmationStatus ?? null, fee: null, lastValidBlockHeight: known?.lastValidBlockHeight ?? null, absence: { proven: false, fate: null, why: null } };
+  if (state === 'landed' || state === 'failed') {
+    try {
+      const tx = await ctx.connection.getTransaction(signature, { commitment: 'confirmed', maxSupportedTransactionVersion: 0 });
+      detail.fee = Number.isSafeInteger(tx?.meta?.fee) ? tx.meta.fee : null;
+    } catch { /* fee stays null */ }
+    return detail;
+  }
+  if (!known?.lastValidBlockHeight) { detail.absence.why = 'the relay has no recorded lifetime for this signature'; return detail; }
+  const f = await fateOf(ctx.connection, { signature, lastValidBlockHeight: known.lastValidBlockHeight, slotFloor: known.slotFloor ?? null }, { fullHistory: ctx.fullHistory === true });
+  detail.absence = { proven: f.fate === 'expired', fate: f.fate, why: f.why };
+  return detail;
+}
