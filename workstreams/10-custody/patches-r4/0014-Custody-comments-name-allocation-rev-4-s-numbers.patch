--- a/frontier-node/crates/verify/src/checks/v26_custody.rs
+++ b/frontier-node/crates/verify/src/checks/v26_custody.rs
@@ -15,7 +15,7 @@
 //! is a FAIL whatever the history. That never upgrades the season: with the
 //! history not replayed, the best a custody season gets is UNVERIFIABLE.
 //!
-//! A trace is: a custody instruction (0xC1–0xCB) of a landed transaction
+//! A trace is: a custody instruction (0xC2–0xCC) of a landed transaction
 //! (top level: a CPI is caught by what it leaves), a custody record
 //! (`LOT_*`, a Lot's CLOSE), or, in any post-state or final account of the
 //! program, a Lot, a Vault with custody counts, a Caravan with custody
diff --git a/permutation-frontier/src/lib.rs b/permutation-frontier/src/lib.rs
index c81bebb9..baf72ff9 100644
--- a/permutation-frontier/src/lib.rs
+++ b/permutation-frontier/src/lib.rs
@@ -94,7 +94,7 @@ pub use error::{CqError, Error, FrontierError, R};
 /// **Custody preview (workstream 10, feature `custody-preview`):** the
 /// binary is a different program: it embeds `RULESET_HASH_V4` and writes
 /// `program_version` 5, so it refuses every S1 Season, and dispatches the
-/// custody tags 0xC1–0xCB, which the S1 build refuses (`BadData`). Hash,
+/// custody tags 0xC2–0xCC, which the S1 build refuses (`BadData`). Hash,
 /// version and dispatch switch together; there is no build that runs
 /// custody under the S1 hash.
 #[cfg(not(feature = "custody-preview"))]
