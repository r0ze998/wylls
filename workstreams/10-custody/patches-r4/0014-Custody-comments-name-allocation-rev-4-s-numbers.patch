From 45cea676bab5b0dbc02037d2d6f3c0c7e0326823 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 02:16:09 +0000
Subject: [PATCH 14/14] Custody: comments name allocation rev 4's numbers

Comments added by the custody series still named the provisional
0xC1-0xCB and kinds 104-112; they now name 0xC2-0xCC and 105-113
(workstream 4's allocation rev 4). Comments only.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01C5Nj2cMNVbfXW4D5Pzsbxg
---
 frontier-node/crates/fclient/src/conquest.rs          | 2 +-
 frontier-node/crates/verify/src/checks/v26_custody.rs | 2 +-
 permutation-frontier/src/lib.rs                       | 2 +-
 permutation-frontier/svm-tests/src/cover/custody.rs   | 2 +-
 permutation-frontier/svm-tests/src/cover/mod.rs       | 2 +-
 5 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/frontier-node/crates/fclient/src/conquest.rs b/frontier-node/crates/fclient/src/conquest.rs
index 92a16077..a26a1840 100644
--- a/frontier-node/crates/fclient/src/conquest.rs
+++ b/frontier-node/crates/fclient/src/conquest.rs
@@ -437,7 +437,7 @@ pub fn parse(body: &[u8]) -> Option<CqLog> {
     let b8 = |name: &str| -> Option<u8> { u(name).map(|v| v as u8) };
     let event = match k {
         // Custody (workstream 10): not a conquest event; a custody reader
-        // decodes these records (`frontier_abi::v2::log`, kinds 104–112).
+        // decodes these records (`frontier_abi::v2::log`, kinds 105–113).
         CqKind::LOT_OPENED
         | CqKind::LOT_QUOTA
         | CqKind::LOT_INBOUND
diff --git a/frontier-node/crates/verify/src/checks/v26_custody.rs b/frontier-node/crates/verify/src/checks/v26_custody.rs
