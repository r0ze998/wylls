+        r,
+        Replayed::Mismatch(
+            "ShipLot landed, but the kernel refuses it on the state before (WalletRequired)".into()
+        )
+    );
+    let mut w = c.w.clone();
+    let mut tl = K::Lot::decode(&w.before[&k.lot_b]).unwrap();
+    tl.owner_tag = 0x99;
