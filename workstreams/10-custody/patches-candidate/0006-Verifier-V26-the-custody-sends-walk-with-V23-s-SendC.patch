+
+    impl W {
+        fn replay(&self, data: &[u8], accounts: &[Key]) -> Replayed {
+            let before = |k: &Key| self.before.get(k).cloned();
+            let after = |k: &Key| self.after.get(k).cloned();
+            replay_ix(&ReplayCase {
+                data,
+                accounts,
+                time: T,
+                bell: Some(BELL),
+                before: &before,
+                after: &after,
+                closed_before: &|_| false,
+                program: PROGRAM,
