+    impl v23::States for W {
+        fn before(&self, k: &Key) -> Option<Vec<u8>> {
+            self.before.get(k).cloned()
+        }
+        fn after(&self, k: &Key) -> Option<Vec<u8>> {
+            self.after.get(k).cloned().flatten()
