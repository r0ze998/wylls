+    fn province() -> Vec<u8> {
+        let mut d = vec![0u8; PR::SIZE];
+        d[PR::P..PR::P + 2].copy_from_slice(&3i16.to_le_bytes());
+        d[PR::Q..PR::Q + 2].copy_from_slice(&(-2i16).to_le_bytes());
+        d[PR::PASSABLE_MASK..PR::PASSABLE_MASK + 8].copy_from_slice(&u64::MAX.to_le_bytes());
