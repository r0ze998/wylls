+        }
+        d[VA::CAP..VA::CAP + 8].copy_from_slice(&v.cap.to_le_bytes());
+        d[VA::CUSTODY_LOTS..VA::CUSTODY_LOTS + 2].copy_from_slice(&v.lots.to_le_bytes());
