From 82119a677185995733481de9897a3effc4d51ed8 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 8 Nov 2026 12:51:42 +0000
Subject: [PATCH] Program custody: share the lot and vault helpers within the
 crate [skip ci]

vault_view, vault_of_lot, put_vault, lot_key, lot_address, lot_of,
put_lot, actor, milli, cerr, kind, lot_raw and emit_lot become
pub(crate), so that other instructions that move a lot (workstream 9's
capacity jobs under capacity-preview) read and write lots and vaults as
the custody handlers do instead of keeping copies. No behaviour change.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01C5Nj2cMNVbfXW4D5Pzsbxg
---
 permutation-frontier/src/proc/custody.rs | 42 ++++++++++++++++--------
 1 file changed, 29 insertions(+), 13 deletions(-)

diff --git a/permutation-frontier/src/proc/custody.rs b/permutation-frontier/src/proc/custody.rs
index 20d44244..be155766 100644
--- a/permutation-frontier/src/proc/custody.rs
+++ b/permutation-frontier/src/proc/custody.rs
@@ -53,12 +53,17 @@ use crate::layout::{citizen2 as C, province2 as P, season2 as S, Ro, Rw};
 use crate::prologue::{self, expect_key, key};
 use crate::{addr, FrontierError, R};
 
-fn kind(k: CqKind) -> u8 {
+// The account helpers below are `pub(crate)` so that other instructions of
+// the program that move a lot (workstream 9's capacity jobs, under
+// `capacity-preview`) read and write lots and vaults as these handlers do,
+// rather than keeping copies of the layout and the checks.
+
+pub(crate) fn kind(k: CqKind) -> u8 {
     k as u8
 }
 
 /// The kernel's refusals as program codes (`02-contract.ja.md` §9).
-fn cerr(e: CustodyError) -> Error {
+pub(crate) fn cerr(e: CustodyError) -> Error {
