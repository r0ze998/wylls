-fn lot_key(l: &Lot) -> LotKey {
+pub(crate) fn lot_key(l: &Lot) -> LotKey {
     LotKey {
         p: l.p,
         q: l.q,
@@ -152,24 +162,24 @@ fn lot_key(l: &Lot) -> LotKey {
     }
