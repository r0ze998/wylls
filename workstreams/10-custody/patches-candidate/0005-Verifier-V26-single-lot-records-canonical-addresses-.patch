+        w.before.insert(k9, vault_bytes(&v9));
+        let a: Vec<Key> = c
+            .accounts
+            .iter()
+            .map(|k| if *k == vault_k() { k9 } else { *k })
+            .collect();
+        assert_eq!(
+            w.replay(&c.data, &a),
+            Replayed::Mismatch(format!(
+                "{name} landed, but its vault account is not the lot's vault"
+            ))
+        );
+    }
+}
