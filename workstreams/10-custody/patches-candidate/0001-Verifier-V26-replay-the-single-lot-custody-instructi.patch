+#[test]
+fn a_step_the_kernel_refuses_is_a_mismatch() {
+    let cs = cases();
+    let get = |n: &str| cs.iter().find(|c| c.name == n).unwrap();
+    // Using more than the order left.
+    let c = get("ConsumeLot");
+    let more = x::ConsumeLot {
