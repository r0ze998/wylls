                 &cq.keep_params(),
                 now_bell,
             )
             .map_err(|_| crate::error::kernel(SUB_KEEP_CAP))?
+            .map(|mut k| {
+                k.heartland_safe = geometry::is_home_heartland(
+                    coord,
+                    holder,
+                    cq.placement,
+                    cq.heartland_max_ring,
+                    &genesis_seed,
+                );
+                k
+            })
         }
         _ => None,
     };
