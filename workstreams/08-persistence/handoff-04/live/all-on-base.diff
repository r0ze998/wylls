+    p.base.r_max = 4;
+    p.cq.r_max_ceiling = 6;
+    p
+}
+
+fn extend(c: &mut Chain, w: &World, d: u16) -> SendResult {
+    let ix = fclient::ix::v2::extend_frontier(&w.a, w.keeper.pubkey(), d);
+    c.send(&[ix], &[&w.keeper])
+}
+
+fn r_max_ext(c: &Chain, w: &World) -> u16 {
+    rd_u16(&c.data(&w.a.frontier()), FR::R_MAX_EXT)
+}
+
+/// Crafted: wedge 0's folded occupancy at `bps` of its open sites.
+fn occupancy(c: &mut Chain, w: &World, bps: u64) {
+    let open0 = rd_u32(&c.data(&w.a.frontier()), FR::WEDGE_OPEN);
+    assert!(open0 > 0, "wedge 0 has open sites (fold first)");
+    let occ = (open0 as u64 * bps / 10_000) as u32;
+    c.edit(&w.a.frontier(), |d| {
+        d[FR::WEDGE_OCCUPIED..FR::WEDGE_OCCUPIED + 4].copy_from_slice(&occ.to_le_bytes())
+    });
+}
+
+/// Seeds ring `d` (OpenRing landed): the Clock moves to its round.
+fn seed_ring(c: &mut Chain, w: &World, d: u16) {
+    let round = rd_u64(&c.data(&w.a.ring_seed(d)), RS::ROUND);
+    c.set_time(World::round_time(round));
+    let arg = w.beacons.must(round);
+    let ix = mix::consume_ring_seed(&w.a, w.keeper.pubkey(), d, &arg);
+    expect_lands(c.send(&[ix], &[&w.keeper]), "ConsumeRingSeed");
+    assert_eq!(c.data(&w.a.ring_seed(d))[RS::STATUS], RS::STATUS_SEEDED);
+}
+
+fn rd_u64(d: &[u8], o: usize) -> u64 {
+    u64::from_le_bytes(d[o..o + 8].try_into().unwrap())
+}
+
+fn terrain_bytes(c: &Chain, w: &World, (p, q): (i16, i16)) -> Vec<u8> {
+    c.data(&w.a.province(p as i32, q as i32))[PV::TERRAIN..PV::SITE_MIRROR].to_vec()
+}
+
+fn dist(a: (i16, i16), b: (i16, i16)) -> u32 {
+    ProvinceCoord::new(a.0 as i32, a.1 as i32).distance(ProvinceCoord::new(b.0 as i32, b.1 as i32))
+}
+
+/// A season without a ceiling (every preset today) cannot grow: `r_max`
+/// stays final and the Frontier's `r_max_ext` stays 0.
+#[test]
+fn extend_frontier_refused_without_a_ceiling() {
+    let mut c = Chain::test_beacon();
+    let w = World::land_v2(&mut c, 1, MC_TEST);
+    assert_eq!(MC_TEST.cq.r_max_ceiling, 0);
+    let r = MC_TEST.base.r_max;
+    assert_code(extend(&mut c, &w, r + 1), E::BadData);
+    assert_eq!(r_max_ext(&c, &w), 0);
+    // Past r_max nothing opens, as before.
+    assert_code(w.open_ring(&mut c, r + 1), E::BadData);
+    assert_code(w.open_province(&mut c, r as i16 + 1, 0), E::BadData);
+}
+
+/// The growth path end to end: refusals, one extension (no duplicate on a
+/// repeat), the new ring opened, seeded and its Province created once,
+/// the old land untouched, and an outpost filed across the old border.
+#[test]
+fn extend_frontier_grows_one_ring_and_keeps_the_old_land() {
+    let mut c = Chain::test_beacon();
+    let w = World::land_v2(&mut c, 1, growing());
+    assert_eq!(w.rings_opened(&c), 4, "genesis rings 0-3");
+    // A home in ring 2 and a ring-3 province, their terrain recorded.
+    let home = provinces_of(2, Some(0))[0];
+    let e = w.final_estate(&mut c, "a", 0, home, 0, 10_000);
+    let t3 = provinces_of(3, Some(0))[0];
+    expect_lands(w.open_province(&mut c, t3.0, t3.1), "OpenProvince (ring 3)");
+    let before = [terrain_bytes(&c, &w, home), terrain_bytes(&c, &w, t3)];
+    w.fold(&mut c);
+
+    // Refusals before ring 4 (= r_max) is open.
+    assert_code(extend(&mut c, &w, 5), E::TooEarly); // ring 4 not open
+    assert_code(extend(&mut c, &w, 4), E::AlreadyDone); // within r_max
+    assert_code(extend(&mut c, &w, 6), E::TooEarly); // not r + 1
+    assert_code(extend(&mut c, &w, 7), E::BadData); // beyond the ceiling
+    assert_code(w.open_ring(&mut c, 5), E::BadData); // beyond r_max
+
+    // Ring 4 (the season's r_max) opens as any ring.
+    c.advance(600);
+    occupancy(&mut c, &w, 10_000);
+    expect_lands(w.open_ring(&mut c, 4), "OpenRing(4)");
+    // The same bell as the last opening.
+    assert_code(extend(&mut c, &w, 5), E::TooEarly);
+    seed_ring(&mut c, &w, 4);
+    c.advance(600);
+    // Below θ: no wedge crowded enough.
+    occupancy(&mut c, &w, 0);
+    assert_code(extend(&mut c, &w, 5), E::Capacity);
+    occupancy(&mut c, &w, 10_000);
+    let l = expect_lands(extend(&mut c, &w, 5), "ExtendFrontier");
+    let r = one_cq(&l.logs, CqKind::FRONTIER_EXTENDED);
+    assert_eq!(r.u64("from"), 4);
+    assert_eq!(r.u64("ceiling"), 6);
+    assert_eq!(r_max_ext(&c, &w), 5);
+    assert_eq!(w.rings_opened(&c), 5, "ExtendFrontier opens no ring");
+    // A repeat (or a copy of the same transaction) changes nothing.
+    assert_code(extend(&mut c, &w, 5), E::AlreadyDone);
+    assert_eq!(r_max_ext(&c, &w), 5);
+
+    // Ring 5 opens, is seeded, and its Province is created once.
+    c.advance(600);
+    expect_lands(w.open_ring(&mut c, 5), "OpenRing(5)");
+    seed_ring(&mut c, &w, 5);
+    let t5 = provinces_of(5, None)
+        .into_iter()
+        .find(|x| dist(home, *x) <= 3)
+        .expect("a ring-5 province within 3 of the home");
+    expect_lands(w.open_province(&mut c, t5.0, t5.1), "OpenProvince (ring 5)");
+    assert_code(w.open_province(&mut c, t5.0, t5.1), E::AlreadyDone);
+    // Ring 6 is within the ceiling but not opened; ring 7 is outside.
+    let t6 = provinces_of(6, Some(0))[0];
+    assert_code(w.open_province(&mut c, t6.0, t6.1), E::SeedNotReady);
+    let t7 = provinces_of(7, Some(0))[0];
+    assert_code(w.open_province(&mut c, t7.0, t7.1), E::BadData);
+    assert_code(w.open_ring(&mut c, 6), E::BadData); // r_max is now 5
+
+    // The old land is byte-for-byte the same.
+    assert_eq!(terrain_bytes(&c, &w, home), before[0]);
+    assert_eq!(terrain_bytes(&c, &w, t3), before[1]);
+
+    // Across the old border: an outpost from the ring-2 home into ring 5.
+    w.fold(&mut c);
+    let s = w.free_sites(&c, t5.0, t5.1)[0];
+    let ix = w.file_outpost_ix(
+        &e,
+        &[Site {
+            p: t5.0,
+            q: t5.1,
+            site: s,
+        }],
+        &e,
+    );
+    expect_lands(c.send(&[ix], &[&e.wallet]), "FileOutpost (ring 5)");
+}
diff --git a/permutation-frontier/svm-tests/tests/placement.rs b/permutation-frontier/svm-tests/tests/placement.rs
new file mode 100644
index 00000000..d4b81ade
--- /dev/null
+++ b/permutation-frontier/svm-tests/tests/placement.rs
@@ -0,0 +1,182 @@
+//! Real VM coverage of the dispersed first-home placement (conquest block
+//! `placement` 1, `permutation_rules::frontier::geometry::home_nation`):
+//! six nations place first homes in small groups spread round the
+//! heartland rings; the placement-0 rule is `first_home.rs`.
+use fclient::ix::Site;
+use frontier_abi::conquest_model::read_keep;
+use frontier_abi::layout::world::season as SE;
+use frontier_abi::v2::layout::player::{citizen as C, holding as H};
+use frontier_abi::v2::layout::province::{province as P, site as S};
+use frontier_abi::v2::presets::{SeasonParamsV2, MC_LOCAL_7D, PLACEMENT_DISPERSED};
+use permutation_frontier_svm_tests::chain::{assert_code, expect_lands, Chain};
+use permutation_frontier_svm_tests::world::land::{rd_i64, Citizen};
+use permutation_frontier_svm_tests::world::World;
+use permutation_frontier_svm_tests::FrontierError as E;
+use permutation_rules::frontier::geometry::{home_nation, ProvinceCoord};
+use solana_instruction::Instruction;
+
+const HMR: u8 = 3;
+
+fn dispersed() -> SeasonParamsV2 {
+    let mut p = MC_LOCAL_7D;
+    p.cq.placement = PLACEMENT_DISPERSED;
+    p.cq.heartland_max_ring = HMR;
+    p
+}
+
+fn seed_of(c: &Chain, w: &World) -> [u8; 32] {
+    let d = c.data(&w.a.season);
+    let mut s = [0u8; 32];
+    s.copy_from_slice(&d[SE::GENESIS_SEED..SE::GENESIS_SEED + 32]);
+    s
+}
+
+fn nation(seed: &[u8; 32], pq: (i16, i16)) -> u8 {
+    home_nation(
+        ProvinceCoord::new(pq.0 as i32, pq.1 as i32),
+        PLACEMENT_DISPERSED,
+        HMR,
+        seed,
+    )
+    .unwrap()
+}
+
+fn place(c: &Chain, w: &World, who: &Citizen, s: Site) -> Instruction {
+    let d = w.citizen_data(c, who);
+    fclient::ix::place_home(&w.a, &who.player(), s, who.faction, d[C::JOIN_SHARD])
+}
+
+/// A dispersed season with every province of rings 2 and 3 open.
+fn setup() -> (Chain, World, [u8; 32], Vec<(i16, i16)>) {
+    let mut c = Chain::test_beacon();
+    let w = World::land_v2(&mut c, 1, dispersed());
+    let mut v = w.open_provinces(&mut c, 2, None);
+    v.extend(w.open_provinces(&mut c, 3, None));
+    let seed = seed_of(&c, &w);
+    (c, w, seed, v)
+}
+
+#[test]
+fn placement_six_nations_place_homes_in_groups_spread_over_wedges() {
+    let (mut c, w, seed, v) = setup();
+    for f in 0..6u8 {
+        let mine: Vec<_> = v
+            .iter()
+            .copied()
+            .filter(|pq| nation(&seed, *pq) == f)
+            .collect();
+        assert_eq!(mine.len(), 5, "2 provinces of ring 2 and 3 of ring 3");
+        let wedges: std::collections::BTreeSet<_> = mine
+            .iter()
+            .map(|(p, q)| ProvinceCoord::new(*p as i32, *q as i32).wedge().unwrap())
+            .collect();
+        assert!(wedges.len() >= 3, "nation {f}: wedges {wedges:?}");
+        // two members of the nation in each of its provinces (a small group)
+        for (i, pq) in mine.iter().enumerate() {
+            for k in 0..2u8 {
+                let who = w.citizen(&mut c, &format!("n{f}-{i}-{k}"), f);
+                let s = Site {
+                    p: pq.0,
+                    q: pq.1,
+                    site: k,
+                };
+                expect_lands(
+                    c.send(&[place(&c, &w, &who, s)], &[&who.wallet]),
+                    "PlaceHome",
+                );
+                let hd = c.data(&w.a.holding(pq.0 as i32, pq.1 as i32, k));
+                assert_eq!(hd[H::STATE], H::STATE_FINAL);
+                // shield: the season's first-holding shield, unchanged by the placement
+                assert_eq!(
+                    rd_i64(&hd, H::SHIELD_UNTIL),
+                    c.now + w.params.cq.shield_secs as i64
+                );
+            }
+        }
+    }
+    // The keep of every heartland province is held by its assigned nation and heartland-safe.
+    for pq in &v {
+        let pd = c.data(&w.a.province(pq.0 as i32, pq.1 as i32));
+        let k = read_keep(&pd).unwrap().expect("a keep");
+        assert_eq!(k.holder, nation(&seed, *pq), "{pq:?}");
+        assert!(k.heartland_safe, "{pq:?}");
+    }
+}
+
+#[test]
+fn placement_refuses_another_nations_province_an_occupied_site_and_a_late_join() {
+    let (mut c, w, seed, v) = setup();
+    let pq = v[0];
+    let owner = nation(&seed, pq);
+    let other = (owner + 1) % 6;
+    // Another nation's assigned province (even inside the joiner's own wedge).
+    let stranger = w.citizen(&mut c, "stranger", other);
+    let s = Site {
+        p: pq.0,
+        q: pq.1,
+        site: 0,
+    };
+    assert_code(
+        c.send(&[place(&c, &w, &stranger, s)], &[&stranger.wallet]),
+        E::BadData,
+    );
+    let own_wedge_foreign = v
+        .iter()
+        .copied()
+        .find(|(p, q)| {
+            ProvinceCoord::new(*p as i32, *q as i32).wedge() == Some(other)
+                && nation(&seed, (*p, *q)) != other
+        })
+        .expect("a province of the stranger's wedge assigned elsewhere");
+    let s2 = Site {
+        p: own_wedge_foreign.0,
+        q: own_wedge_foreign.1,
+        site: 0,
+    };
+    assert_code(
+        c.send(&[place(&c, &w, &stranger, s2)], &[&stranger.wallet]),
+        E::BadData,
+    );
+    // The site taken by one member cannot be taken by a second (no overlap).
+    let a = w.citizen(&mut c, "a", owner);
+    let b = w.citizen(&mut c, "b", owner);
+    expect_lands(c.send(&[place(&c, &w, &a, s)], &[&a.wallet]), "PlaceHome");
+    let pd = c.data(&w.a.province(pq.0 as i32, pq.1 as i32));
+    assert_eq!(pd[P::site(0) + S::STATE], S::STATE_HOLDING);
+    c.next_slot();
+    assert_code(
+        c.send(&[place(&c, &w, &b, s)], &[&b.wallet]),
+        E::TicketState,
+    );
+    // ...but the next site of the same province is free for the second member.
+    let s1 = Site {
+        p: pq.0,
+        q: pq.1,
+        site: 1,
+    };
+    expect_lands(
+        c.send(&[place(&c, &w, &b, s1)], &[&b.wallet]),
+        "PlaceHome (site 1)",
+    );
+    // Join closes at join_close_bell as before.
+    let late = c.funded(b"late-joiner", 10);
+    let mut f = c.fork();
+    f.set_time(w.genesis_ts() + w.params.season.join_close_bell as i64 * 600);
+    assert_code(w.join(&mut f, &late, owner), E::WrongStatus);
+}
+
+#[test]
+fn placement_is_reproducible_from_the_genesis_seed() {
+    let (c, w, seed, v) = setup();
+    let (c2, w2, seed2, _) = setup();
+    assert_eq!(seed, seed2);
+    for pq in &v {
+        let k1 = read_keep(&c.data(&w.a.province(pq.0 as i32, pq.1 as i32)))
+            .unwrap()
+            .unwrap();
+        let k2 = read_keep(&c2.data(&w2.a.province(pq.0 as i32, pq.1 as i32)))
+            .unwrap()
+            .unwrap();
+        assert_eq!(k1.holder, k2.holder);
+    }
+}
