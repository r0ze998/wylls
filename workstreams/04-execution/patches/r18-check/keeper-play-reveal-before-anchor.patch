+fn same_marches(name: &str, want: &BTreeSet<u64>, r: &Run) {
+    let got = revealed_hosts(r);
+    println!("  {name}: revealed Ok {} march(es), normal run {}", got.len(), want.len());
+    assert_eq!(&got, want, "{name}: marches revealed differ from the normal run (missing: {:?})", want.difference(&got).collect::<Vec<_>>());
+}
