diff --git a/frontier-node/crates/keeper/src/reveal_accept.rs b/frontier-node/crates/keeper/src/reveal_accept.rs
index 8db6eb3e..a95ecb2c 100644
--- a/frontier-node/crates/keeper/src/reveal_accept.rs
+++ b/frontier-node/crates/keeper/src/reveal_accept.rs
@@ -148,6 +148,23 @@ pub fn judge(req: &RevealReq, r: &Reads, now: i64) -> Result<Accepted, Refusal>
             ),
         ));
     }
+    // ⑯ P11: the owner's plaintext is taken from the arrival turn's start,
+    // never earlier (this crate's play.rs table: "owner material from
+    // `/v1/reveal` (from the bell start)"; M1 contract §9.3 for the page).
+    // Earlier, a Reveal would put the destination on chain while the march
+    // is still on the road.
+    let opens = s.genesis_ts + 600 * tr.arrive_bell as i64;
+    if now < opens {
+        return Err(refuse(
+            425,
+            "TooEarly",
+            format!(
+                "arrival bell {} starts at {opens}: owner material is taken from then ({} s early)",
+                tr.arrive_bell,
+                opens - now
+            ),
+        ));
+    }
     // 2. The plaintext against the transit.
     let p = seal::unpack(&req.plain);
     seal::validate(&p, tr.host_id, tr.arrive_bell)
