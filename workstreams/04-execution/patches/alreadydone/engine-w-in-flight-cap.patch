+    /// Workstream 04 (AlreadyDone waste, opt-in): with `w_max_in_flight`,
+    /// a W write sends no further version while that many are out with an
+    /// unknown status; it resumes when one is known to have failed or has
+    /// expired; once one landed, nothing more goes out; versions adopted
+    /// after a restart count as out. 0 keeps the every-slot behaviour.
+    #[tokio::test]
+    async fn w_in_flight_cap_unknown_confirmed_and_restart() {
+        let capped = || {
+            Engine::new(
+                Budgets::placeholder(),
+                EngineParams {
+                    w_max_in_flight: 2,
+                    ..EngineParams::default()
+                },
+            )
+        };
+        // Unknown: nothing lands; two versions, then the write waits.
+        let port = Script::default();
+        let mut pay = payers();
+        pay.refresh(&port, 0).await.unwrap();
+        let mut e = capped();
+        e.ensure(spec("w", Class::W, abi::tag::REVEAL), 10);
+        let mut sent = vec![];
+        for s in 10..20 {
+            sent.push(e.step(&port, &mut pay, None, s).await.sent);
+        }
+        assert_eq!(sent.iter().sum::<usize>(), 2, "two in flight, then wait: {sent:?}");
+        // Expired: the first two fall out of their blockhash window, two more go.
+        let mut later = 0;
+        for s in [10 + EXPIRY_SLOTS + 1, 10 + EXPIRY_SLOTS + 2, 10 + EXPIRY_SLOTS + 3] {
+            later += e.step(&port, &mut pay, None, s).await.sent;
+        }
+        assert_eq!(later, 2, "versions past expiry no longer count");
+
+        // A known failure (the retry ladder's case) frees its place at once.
+        let port = Script::default();
+        *port.answer.lock().unwrap() = Box::new(|_| {
+            Some(Status {
+                slot: 11,
+                err: Some("InstructionError(3, ComputationalBudgetExceeded)".into()),
+                code: None,
+            })
+        });
+        let mut pay = payers();
+        pay.refresh(&port, 0).await.unwrap();
+        let mut e = capped();
+        e.ensure(spec("f", Class::W, abi::tag::REVEAL), 10);
+        let mut n = 0;
+        for s in 10..14 {
+            n += e.step(&port, &mut pay, None, s).await.sent;
+        }
+        assert!(n >= 3, "failures are not in flight: {n}");
+
+        // Confirmed: the first version lands; nothing more goes out.
+        let port = Script::default();
+        *port.answer.lock().unwrap() = Box::new(|_| Some(Status { slot: 11, err: None, code: None }));
+        let mut pay = payers();
+        pay.refresh(&port, 0).await.unwrap();
+        let mut e = capped();
+        e.ensure(spec("c", Class::W, abi::tag::REVEAL), 10);
+        let mut n = 0;
+        for s in 10..20 {
+            n += e.step(&port, &mut pay, None, s).await.sent;
+        }
+        assert_eq!(n, 1, "a landed write sends nothing more");
+
+        // After a restart: two versions from the journal are still out.
+        let port = Script::default();
+        let mut pay = payers();
+        pay.refresh(&port, 0).await.unwrap();
+        let mut e = capped();
+        let payer = pay.reveal.addresses()[0];
+        let att = |i: u8| crate::journal::Attempt {
+            sig: Signature::from([i; 64]).to_string(),
+            kind: "test".into(),
+            object_key: "r".into(),
+            bell: Some(3),
+            region: Some(4),
+            class: "W".into(),
+            payer: payer.to_string(),
+            bid_milli: 433,
+            cu_limit: 200_000,
+            heap: None,
+            first_valid_slot: 9,
+            sent_slot: 9,
+            landed_slot: None,
+            status: "sent".into(),
+            code: None,
+        };
+        e.adopt(&[att(1), att(2)]);
+        e.ensure(spec("r", Class::W, abi::tag::REVEAL), 10);
+        let mut n = 0;
+        for s in 10..20 {
+            n += e.step(&port, &mut pay, None, s).await.sent;
+        }
+        assert_eq!(n, 0, "adopted versions in flight count");
+
+        // Off (0): every slot, as the contract says.
+        let port = Script::default();
+        let mut pay = payers();
+        pay.refresh(&port, 0).await.unwrap();
+        let mut e = Engine::new(Budgets::placeholder(), EngineParams::default());
+        e.ensure(spec("o", Class::W, abi::tag::REVEAL), 10);
+        let mut n = 0;
+        for s in 10..16 {
+            n += e.step(&port, &mut pay, None, s).await.sent;
+        }
+        assert_eq!(n, 6);
+    }
+
     /// The first version fails ComputationalBudgetExceeded, the second a
     /// heap fault; the third (1.4M-limit rung ladder + heap frame) lands.
     #[tokio::test]
