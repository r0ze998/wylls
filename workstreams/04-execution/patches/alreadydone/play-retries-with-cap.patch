+
+/// Workstream 04 (AlreadyDone waste, opt-in `w_max_in_flight`): the
+/// retries case with at most 2 Reveal versions out per march. Every march
+/// that the uncapped run reveals is still revealed Ok and settled; the
+/// versions that land `AlreadyDone` drop to at most 1 per march. Secrecy
+/// is not judged here (the base still sends early; workstream 18's fix).
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn ws04_retries_with_in_flight_cap() {
+    let o = || Opts { hold_slots: Some((1_900, 10)), peace_start: Some(0.25), ..Default::default() };
+    W_CAP.with(|c| c.set(0));
+    let Some(r0) = scenario(o()).await else {
+        return;
+    };
+    let want = revealed_hosts(&r0);
+    let _ = audit("cap off", &r0);
+    W_CAP.with(|c| c.set(2));
+    let Some(r) = scenario(o()).await else {
+        return;
+    };
+    W_CAP.with(|c| c.set(0));
+    let fails = audit("cap 2", &r);
+    same_marches("cap 2", &want, &r);
+    let c = r.w.ip.lock();
+    let all = OUT.with(|o| o.borrow().clone());
+    for m in &r.marches {
+        let errs = all
+            .iter()
+            .filter(|x| x.kind == "send" && x.data.windows(32).any(|w| w == m.ct_hash))
+            .filter_map(|x| x.sig.and_then(|s| c.transaction(&s)))
+            .filter(|l| l.err.is_some())
+            .count();
+        assert!(errs <= 1, "host {}: {errs} versions landed with an error under the cap", m.host);
+    }
+    drop(c);
+    let only_early: Vec<_> = fails.iter().filter(|f| !f.contains("after publication")).collect();
+    assert!(only_early.is_empty(), "{only_early:?}");
+}
