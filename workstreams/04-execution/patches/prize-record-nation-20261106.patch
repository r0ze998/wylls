+/// An address with nothing at it: no data, and owned by the System program
+/// or holding no lamports (a closed account).
+fn is_empty(ai: &AccountInfo) -> bool {
+    ai.data_is_empty() && (*ai.owner == SYSTEM_PROGRAM || ai.lamports() == 0)
+}
