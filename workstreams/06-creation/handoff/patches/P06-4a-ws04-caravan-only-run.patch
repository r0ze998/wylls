index 00000000..d1a91310
--- /dev/null
+++ b/workstreams/04-execution/tests/ship_only.rs
@@ -0,0 +1,147 @@
+//! Caravan-only runs (workstream 06's proposal P06-4a): a run with no
+//! facility ships from its stock, is judged on arrival like any other run,
+//! and may wait for an earlier run's caravan as its inbound. The specs are
+//! the JSON workstream 06 hands over (tests/fixtures/ws06-runspecs.json,
+//! written by 06's cli/connect-fixture.mjs). MOCK world; no keys, no
+//! signatures (the simulated chain's signatures are strings).
+
+mod common;
+use common::*;
+use runexec::model::*;
+use runexec::store::run_view;
+
+fn ws06_specs() -> Vec<RunSpec> {
+    serde_json::from_str(include_str!("fixtures/ws06-runspecs.json")).expect("06's RunSpec JSON")
+}
+
+fn view(h: &H, id: &str) -> serde_json::Value {
+    let r = h.run(id);
+    run_view(&r, &h.ex.store.receipts(id).unwrap())
+}
+
+fn out(name: &str, v: &serde_json::Value) {
+    if let Ok(dir) = std::env::var("WS06_VIEW_OUT") {
+        std::fs::write(format!("{dir}/{name}.json"), format!("{}\n", serde_json::to_string_pretty(v).unwrap())).unwrap();
+    }
+}
+
+#[test]
+fn ws06_specs_parse_and_validate() {
+    let specs = ws06_specs();
+    assert_eq!(specs.len(), 2);
+    for s in &specs {
+        assert!(s.facility.is_none());
+        runexec::executor::validate_spec(s).unwrap();
+    }
+    let mut bad = specs[0].clone();
+    bad.inputs[1] = 1;
+    assert!(runexec::executor::validate_spec(&bad).is_err(), "a caravan-only run has no inputs");
+    bad = specs[0].clone();
+    bad.rights_units = 1;
+    assert!(runexec::executor::validate_spec(&bad).is_err());
+}
+
+/// 06's two-caravan plan: the first ships to the depot vault; once it is on
+/// the road its key becomes the second's inbound; the second waits for the
+/// goods at the depot, then ships them on. Both are judged on arrival.
+#[test]
+fn ws06_chain_ships_waits_and_is_judged() {
+    let mut h = H::new("ship-only-chain");
+    let end = holding(1, 1, 3);
+    h.sim.with(|w| w.add_place(end, OWNER, ZERO, None));
+    let mut specs = ws06_specs();
+    let (a, b) = (specs[0].run_id.clone(), specs[1].run_id.clone());
+    h.accept(&specs[0]);
+    for _ in 0..40 {
+        if h.run(&a).state == RunState::InTransit {
+            break;
+        }
+        h.ex.tick().unwrap();
+        h.sim.with(|w| w.advance(1));
+    }
+    let va = view(&h, &a);
+    assert_eq!(va["state"], "InTransit");
+    out("view-haul-in-transit", &va);
+    // what 06's bindInbound does with the view
+    specs[1].inbound = Some(CaravanKey { owner: va["spec"]["owner"].as_u64().unwrap(), seq: va["detail"]["ship_seq"].as_u64().unwrap() as u32 });
+    h.accept(&specs[1]);
+    // the second waits at Accepted while the depot does not hold the goods
+    h.ex.tick().unwrap();
+    assert_eq!(h.run(&b).state, RunState::Accepted);
+    for _ in 0..200 {
+        if h.run(&a).state.terminal() && h.run(&b).state.terminal() {
+            break;
+        }
+        h.ex.tick().unwrap();
+        h.sim.with(|w| w.advance(1));
+    }
+    for id in [&a, &b] {
+        let r = h.run(id);
+        assert_eq!(r.state, RunState::Fulfilled, "{id}");
+        let hist: Vec<(String, String)> = h.ex.store.history(id).unwrap().into_iter().map(|(f, t, _, _)| (f, t)).collect();
+        assert!(hist.contains(&("Accepted".into(), "FacilityConfirmed".into())), "{id}: no facility step");
+        assert!(!hist.iter().any(|(_, t)| t.starts_with("Facility") && t != "FacilityConfirmed"), "{id}: never a facility request");
+        assert_eq!(h.ex.store.reservations_of(id).unwrap(), 0);
+    }
+    let (vb, vfa) = (view(&h, &b), view(&h, &a));
+    // the simulated settle record carries `credited` (proposal P1): both are recorded amounts
+    for v in [&vfa, &vb] {
+        assert!(["Recorded", "RuleDerived"].contains(&v["detail"]["outcome"]["verification"].as_str().unwrap()));
+    }
+    assert_eq!(vb["detail"]["outcome"]["delivered"][1], 4);
+    // the second shipped only after the first arrived
+    let slot_of = |id: &str, kind: &str| h.ex.store.receipts(id).unwrap().into_iter().find(|r| r.kind == kind).map(|r| r.slot).unwrap();
+    assert!(slot_of(&b, "caravan_sent") >= slot_of(&a, "caravan_settled"));
+    out("view-haul-fulfilled", &vfa);
+    out("view-forward-fulfilled", &vb);
+    check_store(&h.ex.store);
+    h.audit();
+}
+
+/// The awaited caravan is burned on the road: the waiting run fails with
+/// InputLost on that evidence, and the first is KnownZero.
+#[test]
+fn ws06_chain_stops_when_the_inbound_is_lost() {
+    let mut h = H::new("ship-only-lost");
+    let end = holding(1, 1, 3);
+    h.sim.with(|w| w.add_place(end, OWNER, ZERO, None));
+    let mut specs = ws06_specs();
+    let (a, b) = (specs[0].run_id.clone(), specs[1].run_id.clone());
+    h.accept(&specs[0]);
+    for _ in 0..40 {
+        if h.run(&a).state == RunState::InTransit {
+            break;
+        }
+        h.ex.tick().unwrap();
+        h.sim.with(|w| w.advance(1));
+    }
+    let key = CaravanKey { owner: OWNER, seq: h.run(&a).detail.ship_seq.unwrap() };
+    specs[1].inbound = Some(key);
+    h.accept(&specs[1]);
+    let home = h.scene.raider_home;
+    h.sim.with(|w| w.raid(key, false, RAIDER, home));
+    for _ in 0..200 {
+        if h.run(&a).state.terminal() && h.run(&b).state.terminal() {
+            break;
+        }
+        h.ex.tick().unwrap();
+        h.sim.with(|w| w.advance(1));
+    }
+    assert_eq!(h.run(&a).detail.outcome.as_ref().unwrap().verification, Verification::KnownZero);
+    assert_eq!(h.run(&b).state, RunState::Failed);
+    assert_eq!(h.run(&b).detail.reason, Some(Reason::InputLost));
+    out("view-forward-input-lost", &view(&h, &b));
+    check_store(&h.ex.store);
+}
+
+/// A run with a facility is unchanged: the standard scene still goes
+/// through Reserved and the facility.
+#[test]
+fn a_run_with_a_facility_still_uses_it() {
+    let mut h = H::new("ship-only-facility-kept");
+    h.accept(&spec("r1", &h.scene));
+    assert!(h.drive("r1", 80).is_none());
+    let hist: Vec<String> = h.ex.store.history("r1").unwrap().into_iter().map(|(_, t, _, _)| t).collect();
+    assert!(hist.contains(&"Reserved".to_string()) && hist.contains(&"FacilityConfirmed".to_string()));
+    assert_eq!(h.run("r1").state, RunState::Fulfilled);
+}
