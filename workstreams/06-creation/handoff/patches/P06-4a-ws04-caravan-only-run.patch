+/// `runexec run accept|view`: a caller (workstream 06) hands a RunSpec as
+/// JSON and reads its run back by run id. One line of JSON on stdout, the
+/// same exit codes as `act` (0 ok, 2 BadRequest, 3 NoRecord, 4 Conflict,
+/// 1 StoreError). It stores and reads only: the executor that ticks the
+/// run is the same as for any other run. Nothing is signed or sent here.
+fn run_cmd(args: &[String], db: &Path) -> Result<serde_json::Value, ActErr> {
+    let bad = |m: &str| (2u8, "BadRequest", m.to_string());
+    let store = Store::open(db).map_err(|e| (1, "StoreError", e))?;
+    match args.get(2).map(String::as_str) {
+        Some("accept") => {
+            let path = arg(args, "--spec").ok_or_else(|| bad("--spec <file> is required"))?;
+            let text = std::fs::read_to_string(&path).map_err(|e| bad(&format!("--spec: {e}")))?;
+            let spec: RunSpec = serde_json::from_str(&text).map_err(|e| bad(&format!("spec: {e}")))?;
+            runexec::executor::validate_spec(&spec).map_err(|e| bad(&e))?;
+            let slot = arg(args, "--slot").and_then(|x| x.parse().ok()).unwrap_or(0);
+            match store.accept(&spec, slot).map_err(|e| (1, "StoreError", e))? {
+                runexec::store::Accept::Conflict => Err((4, "Conflict", format!("{} was accepted with another spec", spec.run_id))),
+                a => Ok(serde_json::json!({ "runId": spec.run_id, "accepted": format!("{a:?}") })),
+            }
+        }
+        Some("view") => {
+            let id = arg(args, "--run").ok_or_else(|| bad("--run <id> is required"))?;
+            let r = store.load(&id).map_err(|e| (1, "StoreError", e))?.ok_or((3, "NoRecord", format!("no run {id}")))?;
+            let receipts = store.receipts(&id).map_err(|e| (1, "StoreError", e))?;
+            Ok(runexec::store::run_view(&r, &receipts))
+        }
+        _ => Err(bad("run accept --spec <file> | run view --run <id>")),
+    }
+}
