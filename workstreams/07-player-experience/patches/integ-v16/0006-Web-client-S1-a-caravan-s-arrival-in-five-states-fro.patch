+  return full ? { state: 'verifiedFull', arrived: recorded, wornBps: sent.wornBps ?? 0 } : { state: 'verifiedPartial', sent: sent.cargo, arrived: recorded, wornBps: sent.wornBps ?? 0 };
+}
