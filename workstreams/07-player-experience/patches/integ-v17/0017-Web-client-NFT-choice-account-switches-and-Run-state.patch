@@ -0,0 +1,30 @@
+// The harness page of ws07-v17.screen.mjs: this round's parts of the real client in a real browser, fed FIXTURE
+// state (no chain, no relay, no wallet, no key): workstream 20's NFT card as workstream 07 connected it (a list not
+// read, a list, an NFT played), the agent page's history with workstream 4's seven send states and a history not read
+// again, and the chronicle's read states (loading, not read, older).
+import { setLang, lang, L } from '../../../permutation-server/web/lang.mjs';
+import { setHtml, html } from '../../../permutation-server/web/util.mjs';
+import { renderNfts } from '../../../permutation-server/web/frontier/screens/join.mjs';
+import * as chron from '../../../permutation-server/web/frontier/screens/chronicle.mjs';
+
+const q = new URLSearchParams(location.search);
+setLang(q.get('lang') === 'en' ? 'en' : 'ja');
+document.documentElement.lang = lang();
+const en = lang() === 'en';
+document.getElementById('title').textContent = en ? 'Workstream 07: this round\'s parts (fixture state)' : '⑦ この回の部品（固定データ）';
+document.getElementById('h-nft').textContent = en ? 'Resident NFTs (20)' : '住民NFT（⑳）';
+document.getElementById('h-chron').textContent = en ? 'Chronicle read states' : '年代記の読み込みの状態';
+
+const W = { address: 'Wa11et1111111111111111111111111111111111111' };
+const A = n => `NFTasset${String(n).repeat(35)}`;
+setHtml(document.getElementById('nft'), html`${[
+  renderNfts({ wallet: W, nftsRead: { ok: false, code: 'HTTP503' } }),
+  renderNfts({ wallet: W, nftsRead: { ok: true }, joinDraft: { faction: 2 }, nfts: { residents: [{ asset: A(1), generation: 3, joined: true }, { asset: A(2), generation: 1, joined: false }, { asset: A(3), generation: null }] } }),
+  renderNfts({ wallet: W, resident: { asset: A(1) } }),
+]}`);
+setHtml(document.getElementById('chron'), html`${[
+  chron.render({ chronicle: undefined, chronicleRead: undefined }),
+  chron.render({ chronicle: undefined, chronicleRead: { ok: false, code: 'HTTP503' } }),
+  chron.render({ chronicle: [], chronicleRead: { ok: false, code: 'network' } }),
+]}`);
+window.ws07 = { ready: true };
diff --git a/permutation-gateway/test/web-frontier-ws07-agent.test.mjs b/permutation-gateway/test/web-frontier-ws07-agent.test.mjs
new file mode 100644
index 00000000..9d33bbd0
--- /dev/null
+++ b/permutation-gateway/test/web-frontier-ws07-agent.test.mjs
@@ -0,0 +1,51 @@
+// Workstream 07: the agent page says what became of each sent action as workstream 4 names it (GET /f/agent/fate:
+// EXECUTION-CONTRACT-20261106 §1, seven states), and a read that fails is not an empty answer. FIXTURE views only;
+// no wallet signs and no key is made.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import * as AG from '../../permutation-server/web/frontier/fagent.mjs';
+import { SEND_STATES } from '../../permutation-server/web/frontier/hud/statusview.mjs';
+import { setLang } from '../../permutation-server/web/lang.mjs';
+
+const text = h => String(h).replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ');
+const view = { agentId: 'ag1', history: [
+  { type: 'action', name: 'Muster', status: 'sent', key: 'k1', at: 1 },
+  { type: 'action', name: 'Depart', status: 'failed', code: 'X', key: 'k2', at: 2, signature: 'sig2' },
+  { type: 'action', name: 'Harvest', status: 'refused', code: 'NotOwner', key: 'k3', at: 3 },
+] };
+
+test('which actions are asked: those that may have left the relay (sent, or failed after it), not a refusal', () => {
+  assert.deepEqual(AG.fateKeys(view), ['k1', 'k2']);
+  assert.deepEqual(AG.fateKeys({ history: Array.from({ length: 14 }, (_, i) => ({ type: 'action', status: 'sent', key: `k${i}` })) }, 10).length, 10);
+});
+
+test('the relay\'s answer is 04\'s state; a failed read or an unknown word is "could not be queried", never a failure', () => {
+  for (const s of SEND_STATES) assert.equal(AG.fateState({ ok: true, state: s }), s);
+  assert.equal(AG.fateState({ ok: false, code: 'HTTP503' }), 'unqueryable');
+  assert.equal(AG.fateState(null), 'unqueryable');
+  assert.equal(AG.fateState({ ok: true, state: 'cancelled' }), 'unqueryable', 'a word 04 does not use is not guessed into one');
+});
+
+test('each sent action carries its state line under it, in Japanese and English; the plain "送信" never stands for the outcome alone', () => {
+  for (const lang of ['ja', 'en']) {
+    setLang(lang);
+    const fates = new Map([['k1', 'pending'], ['k2', 'unknown']]);
+    const h = String(AG.renderHistory(view, { fates }));
+    assert.match(h, /data-key="send:pending"/);
+    assert.match(h, /data-key="send:unknown"/);
+    assert.equal((h.match(/data-key="send:/g) ?? []).length, 2, 'a refused action has no send state');
+    const t = text(h);
+    if (lang === 'en') { assert.match(t, /Waiting to be finalized/); assert.match(t, /The outcome is unknown/); assert.doesNotMatch(t, /[぀-ヿ一-鿿]/); }
+    else { assert.match(t, /確定を待っています/); assert.match(t, /結果は不明です/); }
+    for (const s of SEND_STATES) assert.match(String(AG.renderHistory(view, { fates: new Map([['k1', s]]) })), new RegExp(`data-key="send:${s}"`));
+  }
+  setLang('ja');
+});
+
+test('a history not read again says the shown one is older; an agent never read is not "nothing yet" for a failed read', () => {
+  setLang('en');
+  const t = text(AG.renderHistory(view, { read: { ok: false, code: 'HTTP502' } }));
+  assert.match(t, /The agent(&#39;|')s latest history could not be loaded \(HTTP502\)\. What is shown here is what was loaded before/);
+  assert.doesNotMatch(text(AG.renderHistory(view, { read: { ok: true } })), /could not be loaded/);
+  setLang('ja');
+});
diff --git a/permutation-gateway/test/web-frontier-ws07-nft.test.mjs b/permutation-gateway/test/web-frontier-ws07-nft.test.mjs
new file mode 100644
index 00000000..96fdd62f
--- /dev/null
+++ b/permutation-gateway/test/web-frontier-ws07-nft.test.mjs
@@ -0,0 +1,81 @@
+// Workstream 07: workstream 20's NFT choice and first join on the page (web part of dc55f159), connected to the page's
+// rules: a list of NFTs that could not be read is not "no NFTs"; a wallet change forgets the NFT played and the list
+// and reads the list again; playing an NFT is another viewer (what was read for the wallet's own Citizen goes, its
+// key session stays); the away summary keeps an NFT's marks apart from its wallet's. FIXTURE data only: a fake relay
+// (globalThis.fetch) and a fake herald; no wallet signs, no key is made.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import * as C from '../../permutation-server/web/frontier/controller.mjs';
+import * as io from '../../permutation-server/web/frontier/fchainio.mjs';
+import { FS } from '../../permutation-server/web/frontier/fstate.mjs';
+import { renderNfts } from '../../permutation-server/web/frontier/screens/join.mjs';
+import { setLang } from '../../permutation-server/web/lang.mjs';
+
+const A = 'Wa11et1111111111111111111111111111111111111', B = 'Wa11et2222222222222222222222222222222222222';
+const NFT = 'NFTasset11111111111111111111111111111111111';
+const text = h => String(h).replace(/<[^>]+>/g, ' ');
+const herald = new Proxy({}, { get: () => async () => ({ ok: false, code: 'NotFound' }) });
+async function withFS(over, fn) {
+  const saved = { ...FS }, fetch0 = globalThis.fetch, relay0 = io.relay();
+  try { Object.assign(FS, over); await fn(); } finally {
+    globalThis.fetch = fetch0; io.setRelay(relay0); C.useHerald(null);
+    for (const k of Object.keys(FS)) if (!(k in saved)) delete FS[k]; Object.assign(FS, saved);
+  }
+}
+const nftSeason = { season: { seasonId: 7n, programVersion: 0x8004, joinGate: [0] }, wallet: { address: A } };
+
+test('the NFT list not read: the card says so — not "no NFT" — and offers nothing from it; read with none: no card', async () => {
+  for (const [answer, code] of [[() => ({ ok: false, status: 503, json: async () => ({ code: 'Unavailable' }) }), /\(.+\)/], [() => { throw new TypeError('fetch failed'); }, /\(.+\)/]]) {
+    await withFS(nftSeason, async () => {
+      io.setRelay('http://relay.test'); globalThis.fetch = async () => answer();
+      await C.loadNfts();
+      assert.equal(FS.nftsRead.ok, false);
+      assert.equal(FS.nfts, null);
+      setLang('en');
+      const t = text(renderNfts(FS));
+      assert.match(t, /The resident NFTs of this wallet could not be loaded \(.+\)\. This does not mean it has none/);
+      assert.match(t, code);
+      assert.doesNotMatch(String(renderNfts(FS)), /data-act="nft-login"/);
+      setLang('ja');
+    });
+  }
+  await withFS(nftSeason, async () => {
+    io.setRelay('http://relay.test');
+    globalThis.fetch = async () => ({ ok: true, status: 200, json: async () => ({ ok: true, residents: [], policy: { residentProgram: '11111111111111111111111111111111' } }) });
+    await C.loadNfts();
+    assert.deepEqual([FS.nftsRead.ok, FS.nfts.residents.length], [true, 0]);
+    assert.equal(String(renderNfts(FS)), '', 'read, and none: nothing to offer');
+  });
+});
+
+test('an answer for a wallet no longer connected is dropped', async () => {
+  await withFS(nftSeason, async () => {
+    io.setRelay('http://relay.test');
