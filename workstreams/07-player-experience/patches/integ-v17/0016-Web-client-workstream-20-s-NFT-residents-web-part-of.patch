+// generated by permutation-gateway/scripts/sync-web-sdk.mjs — edit permutation-gateway/client/src
+// NFT residents (workstream 20, provisional until integration): addresses,
+// instruction builders and the relay's classification of JoinResident
+// (0xE1) and ResidentAct (0xE2) — workstream 4's allocation of 2026-11-06.
+//
+//   JoinResident  [owner s] [payer s,w] [season] [frontier] [citizen w] [system]
+//                 [policy] [link w] [asset] [resident] [join_gate s?]
+//                 data: 0xE1 ‖ generation u32 ‖ faction u8
+//   ResidentAct   <the inner player instruction's accounts> [policy] [link] [asset] [resident]
+//                 data: 0xE2 ‖ generation u32 ‖ <the inner instruction's data>
+//
+// One link and one NFT Citizen per season: the same pass joins every world.
+// The NFT Citizen sits where a wallet Citizen would, keyed by the resident ID
+// `sha256("PSF-RES" ‖ asset)[0..15]` instead of the wallet's tag. The
+// `generation` is the resident program's holder generation the owner (or
+// the owner's resident-program session) signs: a transfer bumps it, so a
+// signature from before a transfer is refused (ResidentStaleGeneration).
+//
+// Budgets: the CU and loaded-data overheads below are NOT measured on the
+// SBF build (no runtime run was approved); they are provisional ceilings
+// the relay's simulation checks before anything is sent.
+import { budgetOf, budgetPrefix, PACKET_BYTES } from './budgets.mjs';
+import { seed, SEED_TAGS, SYSTEM_PROGRAM, withSeed } from './addresses.mjs';
+import { TAGS as TAGS_V2 } from './abi-v2-tags.mjs';
+import { concat, u32le, utf8 } from '../bytes.mjs';
+import { sha256 } from '../sha256.mjs';
+import { compileMessage, findProgramAddress, pubkeyBytes } from '../solana-tx.mjs';
+
+export const CREATE_RESIDENT_POLICY_TAG = 0xe0;
+export const JOIN_RESIDENT_TAG = 0xe1;
+export const RESIDENT_ACT_TAG = 0xe2;
+/** Workstream 20's tag band 0xE0–0xE7. */
+export const isResidentTag = t => t >= 0xe0 && t <= 0xe7;
+
+/** The instructions the program runs for an NFT Citizen inside ResidentAct (SetSession is refused there). */
+export const RESIDENT_ACT_NAMES = Object.freeze([
+  'Harvest', 'Build', 'Train', 'Explore', 'Muster', 'Dissolve', 'Garrison', 'Depart',
+  'BuildStructure', 'SeizeStructure', 'CloseStructure', 'FortGarrison', 'Propose', 'Vote',
+  'BuildVault', 'SendCaravan', 'RaidCaravan', 'RaidDomestic', 'SeizeVault', 'CloseVault',
+  'SetVigil', 'FileOutpost', 'FileTicket', 'PlaceHome', 'DeclareSiege', 'RetireHost',
+]);
+const tagOfName = new Map(TAGS_V2.instructions.map(i => [i.name, i.tag]));
+export const RESIDENT_ACT_TAGS = Object.freeze(RESIDENT_ACT_NAMES.map(n => tagOfName.get(n)).filter(t => t !== undefined));
+
+/** Provisional, unmeasured overheads (see the header). */
+export const RESIDENT_CU_OVERHEAD = 40_000;
+export const RESIDENT_LOADED_OVERHEAD = 4_096;
+/** Bytes ResidentAct adds to its inner transaction: 4 keys (32 B + 1 index each) and 5 data bytes. */
+export const RESIDENT_ACT_EXTRA_BYTES = 4 * 33 + 5;
+
+// ------------------------------------------------------------------ addresses
+
+/** The resident ID: `sha256("PSF-RES" ‖ asset)[0..15]`. */
+export const residentTag15 = asset => sha256(utf8('PSF-RES'), pubkeyBytes(asset)).slice(0, 15);
+/** The NFT Citizen of `asset` in the season of `addresses` (a FrontierAddresses). */
+export const residentCitizen = (addresses, asset) => withSeed(addresses.season, seed(SEED_TAGS.Citizen, residentTag15(asset)), addresses.programId);
+/** The Frontier program's resident policy (global). */
+export const policyAddress = programId => findProgramAddress([utf8('nft-resident-policy')], programId)[0];
+/** The link of `asset` in the season `season` (one per season and NFT: the same pass joins every world; SEASON-SCOPE.ja.md). */
+export const linkAddress = (programId, season, asset) => findProgramAddress([utf8('nft-citizen-link'), pubkeyBytes(season), pubkeyBytes(asset)], programId)[0];
+/** The resident program's record of `asset`. */
+export const residentAddress = (residentProgram, asset) => findProgramAddress([utf8('resident'), pubkeyBytes(asset)], residentProgram)[0];
+/** The four proof accounts every ResidentAct and JoinResident names (in the season `season`). */
+export const proofAccounts = ({ programId, season, residentProgram, asset }) => ({
+  policy: policyAddress(programId),
+  link: linkAddress(programId, season, asset),
+  asset: typeof asset === 'string' ? asset : null,
+  resident: residentAddress(residentProgram, asset),
+});
+
+// ------------------------------------------------------------------ account readers
+
+const u32At = (d, o) => d[o] | (d[o + 1] << 8) | (d[o + 2] << 16) | (d[o + 3] * 2 ** 24);
+const i64At = (d, o) => { let v = 0n; for (let i = 7; i >= 0; i--) v = (v << 8n) | BigInt(d[o + i]); return BigInt.asIntN(64, v); };
+
+/** The resident program's record (133 B): generation and session, or null. */
+export function decodeResident(d) {
+  const b = Uint8Array.from(d ?? []);
+  if (b.length !== 133 || b[0] !== 0xc2) return null;
+  return {
+    asset: b.slice(1, 33),
+    generation: u32At(b, 48) >>> 0,
+    session: b.slice(52, 84),
+    sessionExpiry: i64At(b, 84),
+    sessionGeneration: u32At(b, 92) >>> 0,
+    sessionSetter: b.slice(96, 128),
+  };
+}
+
+/** A Core AssetV1's owner (bytes 1..33) and collection (34..66), or null. */
+export function decodeAssetOwner(d) {
+  const b = Uint8Array.from(d ?? []);
+  if (b.length < 66 || b[0] !== 1 || b[33] !== 2) return null;
+  return { owner: b.slice(1, 33), collection: b.slice(34, 66) };
+}
+
+// ------------------------------------------------------------------ builders
+
+const ro = pubkey => ({ pubkey, isSigner: false, isWritable: false });
+
+/** JoinResident (the first login of an NFT): see the header for the accounts. */
+export function joinResidentIx({ programId, owner, payer, season, frontier, citizen, policy, link, asset, resident, joinGate = null, generation, faction }) {
+  const keys = [
+    { pubkey: owner, isSigner: true, isWritable: false },
+    { pubkey: payer, isSigner: true, isWritable: true },
+    ro(season), ro(frontier),
+    { pubkey: citizen, isSigner: false, isWritable: true },
+    ro(SYSTEM_PROGRAM), ro(policy),
+    { pubkey: link, isSigner: false, isWritable: true },
+    ro(asset), ro(resident),
+  ];
+  if (joinGate) keys.push({ pubkey: joinGate, isSigner: true, isWritable: false });
+  return { programId, keys, data: concat([JOIN_RESIDENT_TAG], u32le(generation), [faction]) };
+}
+
+/** ResidentAct around an inner player instruction (from `frontierIx`) whose actor is the owner or its session. */
+export function residentActIx(inner, { generation, policy, link, asset, resident }) {
+  const tag = inner.data[0];
+  if (!RESIDENT_ACT_TAGS.includes(tag)) throw new Error(`instruction 0x${tag.toString(16)} is not run for an NFT Citizen`);
+  return {
+    programId: inner.programId,
+    keys: [...inner.keys, ro(policy), ro(link), ro(asset), ro(resident)],
+    data: concat([RESIDENT_ACT_TAG], u32le(generation), inner.data),
+  };
+}
+
+/** The budget of a ResidentAct around `inner` (a tag or name) or of JoinResident (`'JoinResident'`). */
+export function residentBudget(inner, profile = 1) {
+  const b = budgetOf(inner === 'JoinResident' ? 'Join' : inner, profile);
+  if (!b) return null;
+  const extra = inner === 'JoinResident' ? RESIDENT_ACT_EXTRA_BYTES - 32 : RESIDENT_ACT_EXTRA_BYTES;
+  return {
+    ...b,
+    name: inner === 'JoinResident' ? 'JoinResident' : b.name,
+    cuLimit: b.cuLimit + RESIDENT_CU_OVERHEAD,
+    loadedLimit: b.loadedLimit + RESIDENT_LOADED_OVERHEAD,
+    txCeiling: Math.min(b.txCeiling + extra, PACKET_BYTES),
+  };
+}
+
+/** The sponsored message of a ResidentAct: the budget prefix at CU price 0, then the wrapped instruction. */
+export function residentActMessage({ inner, proof, generation, feePayer, recentBlockhash, profile = 1 }) {
+  const b = residentBudget(inner.data[0], profile);
+  return compileMessage({ feePayer, recentBlockhash, instructions: [
+    ...budgetPrefix(inner.data[0], { profile, cuLimit: b.cuLimit, loadedLimit: b.loadedLimit }),
+    residentActIx(inner, { generation, ...proof }),
+  ] });
+}
+
+/** The sponsored message of a JoinResident. */
+export function joinResidentMessage({ feePayer, recentBlockhash, profile = 1, ...fields }) {
+  const b = residentBudget('JoinResident', profile);
+  return compileMessage({ feePayer, recentBlockhash, instructions: [
+    ...budgetPrefix('Join', { profile, cuLimit: b.cuLimit, loadedLimit: b.loadedLimit }),
+    joinResidentIx({ ...fields, payer: fields.payer ?? feePayer }),
+  ] });
+}
+
+// ------------------------------------------------------------------ relay classification
+
+const refuse = (code, problem) => ({ ok: false, code, problem });
+
+const JOIN_RESIDENT_SPEC = Object.freeze([
+  { name: 'owner', signer: true, writable: false },
+  { name: 'payer', signer: true, writable: true },
+  { name: 'season', signer: false, writable: false },
+  { name: 'frontier', signer: false, writable: false },
+  { name: 'citizen', signer: false, writable: true },
+  { name: 'system', signer: false, writable: false, system: true },
+  { name: 'policy', signer: false, writable: false },
+  { name: 'link', signer: false, writable: true },
+  { name: 'asset', signer: false, writable: false },
+  { name: 'resident', signer: false, writable: false },
+]);
+const JOIN_GATE_SPEC = Object.freeze({ name: 'join_gate', signer: true, writable: false });
+
+/** The message's keys and flags are exactly the instruction's (as `classify` requires of every shape). */
+function exactMessage(tx, programId, keys, spec, feePayer, prefixPrograms) {
+  const want = new Map([[feePayer, true]]);
+  keys.forEach((k, i) => want.set(k.pubkey, (want.get(k.pubkey) ?? false) || !!spec[i].writable));
+  for (const prog of [...prefixPrograms, programId]) {
+    if (want.has(prog)) return `the shape may not pass a program id (${prog}) as an account`;
+    want.set(prog, false);
+  }
+  if (tx.accountKeys.length !== want.size || tx.accountKeys.some(k => !want.has(k))) return 'the message names account keys no instruction of the shape uses';
