+      ...tx,
+      instructions: [...tx.instructions.slice(0, 3), { programId, keys: innerKeys, data: inner }],
+      accountKeys: tx.accountKeys.filter(k => !proofKeys.includes(k)),
+      header: { ...tx.header, numReadonlyUnsignedAccounts: ru - 4 },
+    };
