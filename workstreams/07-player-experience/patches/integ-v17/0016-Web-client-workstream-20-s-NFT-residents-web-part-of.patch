+    if (wireBytes !== undefined && wireBytes > budget.txCeiling) return refuse('RelayRejected', `${wireBytes} bytes is over ResidentAct(${budget.name})'s ceiling of ${budget.txCeiling}`);
+    const shape = classify(innerTx, { programId, profile, budget });
+    if (!shape.ok) return shape;
+    if (shape.kind !== 'player') return refuse('RelayRejected', 'ResidentAct wraps a player shape only');
+    const [policy, link, asset, resident] = proofKeys;
+    return { ...shape, keys: ix.keys, wrapper: 'ResidentAct', resident: { generation, policy, link, asset, resident } };
+  }
+  if (tag === JOIN_RESIDENT_TAG) {
+    if (ix.data.length !== 6) return refuse('RelayRejected', 'JoinResident data: 0xE1, generation u32, faction u8');
+    const budget = residentBudget('JoinResident', profile);
+    const [limit, price, loaded] = prefix;
+    if (price !== 0n) return refuse('RelayRejected', 'SetComputeUnitPrice must be 0 on a sponsored shape');
+    if (limit !== budget.cuLimit) return refuse('RelayRejected', `SetComputeUnitLimit must be ${budget.cuLimit} for JoinResident`);
+    if (loaded !== budget.loadedLimit) return refuse('RelayRejected', `SetLoadedAccountsDataSizeLimit must be ${budget.loadedLimit} for JoinResident`);
+    const spec = ix.keys.length === 11 ? [...JOIN_RESIDENT_SPEC, JOIN_GATE_SPEC] : ix.keys.length === 10 ? JOIN_RESIDENT_SPEC : null;
+    if (!spec) return refuse('RelayRejected', `JoinResident does not take ${ix.keys.length} accounts`);
+    const accounts = {};
+    for (let i = 0; i < spec.length; i++) {
+      const want = spec[i], have = ix.keys[i];
+      if (want.signer !== have.isSigner) return refuse('RelayRejected', `JoinResident account ${i} (${want.name}) ${want.signer ? 'must' : 'may not'} sign`);
+      if (want.writable !== have.isWritable) return refuse('RelayRejected', `JoinResident account ${i} (${want.name}) must be ${want.writable ? 'writable' : 'read-only'}`);
+      if (want.system && have.pubkey !== SYSTEM_PROGRAM) return refuse('RelayRejected', 'JoinResident account 5 must be the system program');
+      accounts[want.name] = have.pubkey;
+    }
+    const feePayer = tx.signers[0];
+    if (accounts.payer !== feePayer) return refuse('RelayRejected', 'the instruction\'s payer account must be the fee payer');
+    if (accounts.owner === feePayer) return refuse('RelayRejected', 'the fee payer cannot also be the owner');
+    const problem = exactMessage(tx, programId, ix.keys, spec, feePayer, prefixPrograms);
+    if (problem) return refuse('RelayRejected', problem);
+    const wanted = [feePayer, accounts.owner, ...(accounts.join_gate ? [accounts.join_gate] : [])];
+    if (tx.signers.length !== wanted.length || wanted.some(k => !tx.signers.includes(k))) return refuse('RelayRejected', 'the fee payer, the owner (and the join gate) sign, nobody else');
+    if (wireBytes !== undefined && wireBytes > budget.txCeiling) return refuse('RelayRejected', `${wireBytes} bytes is over JoinResident's ceiling of ${budget.txCeiling}`);
+    return {
+      ok: true, kind: 'player', wrapper: 'JoinResident', tag: JOIN_RESIDENT_TAG, name: 'JoinResident', feePayer, authority: accounts.owner,
+      signers: tx.signers, accounts, keys: ix.keys,
+      data: { generation: u32At(ix.data, 1) >>> 0, faction: ix.data[5] }, budget,
+      resident: { generation: u32At(ix.data, 1) >>> 0, policy: accounts.policy, link: accounts.link, asset: accounts.asset, resident: accounts.resident },
+    };
+  }
+  return refuse('RelayRejected', `resident instruction 0x${tag.toString(16)} is not a sponsored shape`);
+}
