+      const w = f.proposal === 'stance' ? L`${nation(f.target)}への方針を「${stance(f.value)}」に` : f.proposal === 'expel' ? (f.aboutMe ? L`あなたの村の追放` : L`村の追放`) : L`村を国に戻すこと`;
