+  <style>html, body { height: auto; overflow: auto; } .ws07-harness { max-width: 760px; margin: 0 auto; padding: 16px; } #feed { display: grid; gap: 8px; } h1 { font-size: 1.1rem; color: var(--land); } h2 { font-size: 1rem; margin-top: 24px; color: var(--land); } /* the drawer's sheet, where these lines stand on the page */ #contract { background: var(--paper-sheet); color: var(--ink); padding: 8px 12px; border-radius: 2px; }</style>
+</head>
+<body>
