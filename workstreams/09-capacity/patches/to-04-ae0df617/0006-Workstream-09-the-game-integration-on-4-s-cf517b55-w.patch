++const POOL_SPACE: usize = cap::layout::pool::SIZE + fc::RENT_TO_LEN;
++const JOB_SPACE: usize = cap::layout::job::SIZE + fc::RENT_TO_LEN;
++const VAULT_TILE: u8 = 22;
++
++fn err(code: cap::CapError) -> u32 {
++    fc::program_error(code.code())
++}
