++            Some(Pool {
++                facility: FacilityId { p, q, site, gen },
++                owner,
++                policies,
++                lent,
++                owner_seq,
++                last_owner_op,
++                grants,
++                occ,
++                lost_at,
++                captor,
++                last_grant_seq,
++                next_uid,
++            })
++        }
++    }
