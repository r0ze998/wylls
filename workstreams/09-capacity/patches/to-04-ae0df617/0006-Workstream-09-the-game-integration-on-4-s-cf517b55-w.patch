++            for i in 0..MAX_GRANTS {
++                let start = *o;
++                if let Some(g) = self.grants.get(i) {
++                    put(d, o, &g.seq.to_le_bytes());
++                    put(d, o, &g.user);
++                    put(d, o, &[g.recipe]);
++                    put(d, o, &g.max_units.to_le_bytes());
