++            let ctx = format!("seed {seed} step {step} {op:?}");
++            let rk = from_kernel(k.apply(now, signer, &op));
++            let rp = from_port(port.apply(now, signer, &op));
++            assert_eq!(rk, rp, "{ctx}: outcome");
++            match &rk {
++                Res::Applied(_) => {
