++            }
++            put(d, o, &self.forfeited_out.to_le_bytes());
++            put(d, o, &[self.deposits.len() as u8]);
++            for x in &self.deposits {
++                put(d, o, &x.id.to_le_bytes());
++                put(d, o, &[x.input]);
++                put(d, o, &x.amount.to_le_bytes());
++                put(d, o, &x.src.to_le_bytes());
++            }
++            Some(())
++        }
++
++        pub fn decode(d: &[u8]) -> Option<Job> {
++            if d.len() < job::SIZE {
++                return None;
++            }
++            check_header(d, job::MAGIC, job::VERSION, job::ACCOUNT_KIND)?;
++            let mut off = job::HEADER;
++            let o = &mut off;
++            let grant = u32_(d, o)?;
++            let seq = u32_(d, o)?;
++            let uid = u64_(d, o)?;
++            let user = key(d, o)?;
++            let recipe_id = u8_(d, o)?;
++            recipe(recipe_id)?;
++            let units = u32_(d, o)?;
++            let start = i64_(d, o)?;
++            let end = i64_(d, o)?;
++            let max_output = i64_(d, o)?;
++            let hopper = [i64_(d, o)?, i64_(d, o)?];
++            let fc = u8_(d, o)?;
++            let ft = i64_(d, o)?;
++            let fin = match fc {
++                0 => Fin::Open,
++                1 => Fin::Completed(ft),
++                2 => Fin::Cancelled(ft),
++                3 => Fin::Lost(ft),
++                _ => return None,
++            };
++            let settled = i64_(d, o)?;
++            let started_logged = u8_(d, o)? == 1;
++            let claimed = i64_(d, o)?;
++            let refunded = u8_(d, o)? == 1;
++            let returned = [i64_(d, o)?, i64_(d, o)?];
++            let forfeited_in = [i64_(d, o)?, i64_(d, o)?];
++            let forfeited_out = i64_(d, o)?;
++            let n = u8_(d, o)? as usize;
++            if n > MAX_DEPOSITS {
++                return None;
++            }
++            let mut deposits = Vec::with_capacity(n);
++            for _ in 0..n {
++                deposits.push(Deposit {
++                    id: u64_(d, o)?,
++                    input: u8_(d, o)?,
++                    amount: i64_(d, o)?,
++                    src: u64_(d, o)?,
++                });
++            }
++            Some(Job {
++                grant,
++                seq,
++                uid,
++                user,
++                recipe: recipe_id,
++                units,
++                start,
++                end,
++                max_output,
++                hopper,
++                deposits,
++                fin,
++                settled,
++                started_logged,
++                claimed,
++                refunded,
++                returned,
++                forfeited_in,
++                forfeited_out,
++            })
++        }
++    }
++}
