++        pub fn decode(d: &[u8]) -> Option<Pool> {
++            if d.len() < pool::SIZE {
++                return None;
++            }
++            check_header(d, pool::MAGIC, pool::VERSION, pool::ACCOUNT_KIND)?;
++            let mut off = pool::HEADER;
++            let o = &mut off;
++            let p = i16::from_le_bytes(take(d, o, 2)?.try_into().ok()?);
