++struct Cap {
++    w: World,
++    c: ProvinceCoord,
++    a: Member,
++    b: Member,
++    holding: AccountInfo<'static>,
++    pool: AccountInfo<'static>,
++    vault: AccountInfo<'static>,
++    jobs: HashMap<(u32, u32), AccountInfo<'static>>,
++}
