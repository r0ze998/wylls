++/// The kernel's events in the rules' terms (the pool implied, places the
++/// program's to fill in).
++fn events(ev: &[Event]) -> Vec<cap::Event> {
++    let k = |j: JobId| (j.grant.seq, j.seq);
++    ev.iter()
++        .map(|e| match e.clone() {
++            Event::PoolOpened { owner, .. } => cap::Event::PoolOpened { owner: owner.0 },
++            Event::Lent {
++                units, lent, at, ..
++            } => cap::Event::Lent { units, lent, at },
++            Event::Reclaimed {
++                units, lent, at, ..
++            } => cap::Event::Reclaimed { units, lent, at },
++            Event::Granted { grant, user } => cap::Event::Granted {
++                grant: grant.seq,
++                user: user.0,
++            },
++            Event::Revoked {
++                grant,
++                at,
++                cancelled,
++            } => cap::Event::Revoked {
++                grant: grant.seq,
++                at,
++                cancelled,
++            },
++            Event::Reserved {
++                job,
++                units,
++                start,
++                end,
++                max_output,
++            } => cap::Event::Reserved {
++                job: k(job),
++                units,
++                start,
++                end,
++                max_output,
++            },
++            Event::Deposited {
++                job,
++                deposit,
++                resource,
++                amount,
++            } => cap::Event::Deposited {
++                job: k(job),
++                deposit,
++                resource,
++                amount,
++            },
++            Event::Started { job, at } => cap::Event::Started { job: k(job), at },
++            Event::Settled {
++                job,
++                out,
++                used,
++                total,
++            } => cap::Event::Settled {
++                job: k(job),
++                out,
++                used,
++                total,
++            },
++            Event::Completed { job, at, out } => cap::Event::Completed {
++                job: k(job),
++                at,
++                out,
++            },
++            Event::Cancelled { job, at, out } => cap::Event::Cancelled {
++                job: k(job),
++                at,
++                out,
++            },
++            Event::Lost { job, at, out } => cap::Event::Lost {
++                job: k(job),
++                at,
++                out,
++            },
++            Event::Claimed {
++                job,
++                output,
++                refund,
++                ..
++            } => cap::Event::Claimed {
++                job: k(job),
++                output,
++                refund,
