+test('a world without an end bell: the NOW line names no end and never "undefined"; a finite end keeps its old words', () => {
+  const { renderer } = setup();
+  const me = { faction: 0, stores: [1, 2, 3, 4, 5, 6, 7, 8], rates_per_hour: [] };
+  const now = sit => renderer.stateLines({ bell: 300, day: 2, bell_in_day: 12, me, ...sit }).find((l) => l.startsWith('NOW:'));
+  assert.equal(now({}), 'NOW: turn 300 (day 2, turn 12/144).');
+  assert.equal(now({ end_bell: null }), 'NOW: turn 300 (day 2, turn 12/144).');
+  assert.equal(now({ end_bell: 1008 }), 'NOW: turn 300 (day 2, turn 12/144). Season ends at turn 1008.');
+});
