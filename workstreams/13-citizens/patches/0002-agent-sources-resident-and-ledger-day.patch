diff --git a/permutation-gateway/test/agent-wallet-caps.test.mjs b/permutation-gateway/test/agent-wallet-caps.test.mjs
index 81de7b15..f101b8eb 100644
--- a/permutation-gateway/test/agent-wallet-caps.test.mjs
+++ b/permutation-gateway/test/agent-wallet-caps.test.mjs
@@ -213,3 +213,15 @@ test('the operator token itself is never written: not in a settlement, the opera
   assert.ok(r.gateway.ledger.db.settlements.every(s => /^[0-9a-f]{8}$/.test(s.by.token) && s.claimedBy === 'label'));
   sound(r);
 });
+
+test('a ledger may budget by its own day (a game day) instead of the UTC day', async () => {
+  const { AgentLedger } = await import('../src/frontier/agent/ledger.mjs');
+  let t = 0;
+  const l = new AgentLedger({ now: () => t, dayKey: ms => `g${Math.floor(ms / 86_400_000)}` });
+  l.create({ agentId: 'a', owner: 'o', agentKey: 'k', village: [0, 0, 0], policy: { allowed: [], budget: { total: '100', perDay: '100', callsPerDay: 1 } } });
+  l.hold('a', { category: 'inference', amount: '0', key: 'k1' });
+  assert.throws(() => l.hold('a', { category: 'inference', amount: '0', key: 'k2' }), /model call/);
+  t = 86_400_000;
+  assert.doesNotThrow(() => l.hold('a', { category: 'inference', amount: '0', key: 'k3' }));
+  assert.equal(l.get('a').day.key, 'g1');
+});
