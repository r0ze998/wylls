+/**
+ * ①の入口（提案）：国をまたぐ物資の依頼の画面へ、この村を届け先にして開く。依頼に応じても物は動かない。
+ * 物を送るのは上の「隊商を送る」（ほかの人あてはウォレットで署名）だけ。開く先は統合のときに決める（今は①の板の /ws01/）。
+ */
+export const COOP_PAGE = '/ws01/repo/workstreams/01-national-strategy/coop/';
+function coopEntry(m) {
+  const home = m.sources.find(s => s.kind === 'holding');
+  if (!home) return '';
+  const to = [home.p, home.q, home.site, home.gen ?? 0].join(',');
+  return fold('s1-coop', html`${icon('flag')}${L`国をまたぐ依頼`}`, html`<p class="muted">${L`ほかの人に物資を頼む・頼みに応じる画面を開きます。応じても物は自動では動かず、送る義務もありません。送るときは「隊商を送る」から、自分のウォレットで署名します。`}</p>
+    <div class="actions"><a class="btn" href="${COOP_PAGE}?to=${to}" target="_blank" rel="noopener">${L`依頼の画面を開く（この村を届け先に）`}</a></div>`);
+}
