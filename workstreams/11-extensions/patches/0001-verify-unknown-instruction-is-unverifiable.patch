--- /dev/null
+++ b/frontier-node/crates/verify/tests/unknown_ix.rs
@@ -0,0 +1,64 @@
+//! Workstream 11, patch 0001: a successful transaction whose Frontier
+//! instruction carries a tag this verifier does not know (an operation a
+//! later program may have, e.g. an extension call) is UNVERIFIABLE, not a
+//! silent PASS: no check judges it, so its effects are unjudged.
+
+mod common;
+
+use common::*;
+use verify_core::Verdict;
+
+/// The land fixture with one more Frontier instruction (`tag`, no
+/// accounts) appended to its first successful Frontier transaction.
+fn with_extra_ix(tag: u8) -> verify_core::input::Input {
+    let mut inp = land();
+    let program = inp.cfg.program;
+    let t = inp
+        .txs
+        .iter()
+        .position(|r| {
+            r.err.is_none()
+                && fclient::tx::from_wire(&r.tx).is_ok_and(|tx| {
+                    let keys = &tx.message.account_keys;
+                    tx.message
+                        .instructions
+                        .iter()
+                        .any(|c| keys[c.program_id_index as usize] == program)
+                })
+        })
+        .expect("a successful Frontier transaction");
+    let mut tx = fclient::tx::from_wire(&inp.txs[t].tx).expect("tx");
+    let keys = tx.message.account_keys.clone();
+    let mut extra = tx
+        .message
+        .instructions
+        .iter()
+        .find(|c| keys[c.program_id_index as usize] == program)
+        .cloned()
+        .expect("a Frontier instruction");
+    extra.data = vec![tag];
+    extra.accounts.clear();
+    tx.message.instructions.push(extra);
+    inp.txs[t].tx = fclient::tx::wire(&tx);
+    inp
+}
+
+#[test]
+fn the_fixture_passes_unchanged() {
+    let r = verify_core::verify(&land());
+    assert_eq!(r.verdict, Verdict::Pass, "{}", show(&r));
+}
+
+#[test]
+fn an_unknown_instruction_is_not_a_pass() {
+    assert!(frontier_abi::v2::Ix::from_tag(0xD4).is_none());
+    let r = verify_core::verify(&with_extra_ix(0xD4));
+    println!("verdict with an unknown tag 0xD4: {:?}\n{}", r.verdict, show(&r));
+    assert_ne!(r.verdict, Verdict::Pass, "{}", show(&r));
+    // With patch 0001: UNVERIFIABLE, and only for that reason.
+    assert_eq!(r.verdict, Verdict::Unverifiable, "{}", show(&r));
+    assert!(r
+        .findings
+        .iter()
+        .any(|f| f.check == "V2" && f.code == "MissingData"));
+}
