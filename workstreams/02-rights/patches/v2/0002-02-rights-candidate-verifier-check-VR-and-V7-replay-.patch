+fn meta(k: Key, s: bool, w: bool) -> AccountMeta {
+    let a = Address::new_from_array(k);
+    if w {
+        AccountMeta::new(a, s)
+    } else {
+        AccountMeta::new_readonly(a, s)
+    }
